---
/**
 * WelcomeSection — "Como en casa desde el primer día"
 * This is a differentiation section, not a list of appliances.
 * Give it visual prominence: dark background, large serif heading, generous spacing.
 */
import SvgIcon, { type IconName } from './SvgIcon.astro';
import type { SiteContent } from '../content/index';

interface Props {
  welcome: SiteContent['welcome'];
}

const { welcome } = Astro.props;
---

<section class="section welcome-section" id="bienvenida" aria-labelledby="welcome-title">
  <div class="container">
    <div class="welcome-grid">
      <!-- Left: heading + closing line -->
      <div class="welcome-intro reveal">
        <hr class="divider welcome-divider" aria-hidden="true" />
        <p class="section-label welcome-label">{welcome.sectionLabel}</p>
        <h2 class="section-title welcome-headline" id="welcome-title">
          {welcome.headline.split('\n').map((line) => (
            <span class="welcome-headline-line">{line}</span>
          ))}
        </h2>
      </div>

      <!-- Right: welcome items -->
      <ul class="welcome-items" role="list">
        {welcome.items.map((item, i) => (
          <li class:list={['welcome-item', 'reveal', `reveal-delay-${i + 1}`]}>
            <div class="welcome-item-icon"><SvgIcon name={item.icon as IconName} /></div>
            <div class="welcome-item-text">
              <span class="welcome-item-label">{item.label}</span>
              {item.detail && <span class="welcome-item-detail">{item.detail}</span>}
            </div>
            <svg class="welcome-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .welcome-section {
    background-color: var(--bg-dark);
    color: var(--text-on-dark);
    /* Deliberate dark section — picks up the navy world from the hero */
  }

  .section-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    margin-bottom: var(--sp-3);
  }

  .welcome-label {
    color: var(--color-teal-300);
  }

  .welcome-divider {
    background-color: var(--color-teal-600);
  }

  /* ── Grid ─────────────────────────────────────────────────────────────────── */
  .welcome-grid {
    display: grid;
    gap: var(--sp-16);
  }

  /* ── Intro ───────────────────────────────────────────────────────────────── */
  .welcome-headline {
    color: var(--color-chalk-50);
    margin-bottom: var(--sp-5);
  }

  .welcome-headline-line { display: block; }

  /* ── Items ───────────────────────────────────────────────────────────────── */
  .welcome-items {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
    padding: 0;
  }

  @media (min-width: 640px) {
    .welcome-items {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .welcome-items {
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }
  }

  .welcome-item {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-4);
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--t-base), transform var(--t-base);
  }

  .welcome-item:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .welcome-item-icon {
    color: var(--color-teal-400);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background-color: rgba(255, 255, 255, 0.1);
  }

  .welcome-item-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .welcome-item-label {
    font-size: var(--text-base);
    font-weight: var(--fw-semibold);
    color: var(--color-chalk-50);
    line-height: var(--leading-snug);
  }

  .welcome-item-detail {
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    line-height: var(--leading-normal);
  }

  .welcome-check {
    color: var(--color-teal-400);
    flex-shrink: 0;
  }
</style>
