---
/**
 * ContactSection — wraps the React ContactForm island.
 */
import ContactForm from './ContactForm';
import * as content from '../content/index';
const { contact } = content;
---

<section class="section contact-section" id="contacto" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-grid">
      <!-- Left: heading + lead -->
      <div class="contact-intro reveal">
        <hr class="divider" aria-hidden="true" />
        <p class="section-label">{contact.sectionLabel}</p>
        <h2 class="section-title contact-headline" id="contact-title">{contact.headline}</h2>
        <p class="section-lead">{contact.lead}</p>

        <div class="contact-reassurances" aria-label="Por qué contactarnos">
          <div class="contact-reassurance">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="reassurance-icon">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.6 3.27 2 2 0 0 1 3.57 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.66a16 16 0 0 0 6 6l.95-.93a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>Respuesta rápida — normalmente en el mismo día</span>
          </div>
          <div class="contact-reassurance">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="reassurance-icon">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Sin compromiso — solo una consulta</span>
          </div>
          <div class="contact-reassurance">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="reassurance-icon">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span>Atención directa del propietario</span>
          </div>
        </div>
      </div>

      <!-- Right: form island -->
      <div class="contact-form-wrapper">
        <ContactForm client:load />
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: var(--bg-surface-alt);
  }

  .section-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-3);
  }

  .contact-grid {
    display: grid;
    gap: var(--sp-12);
    align-items: start;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1.5fr;
      gap: var(--sp-16);
    }
  }

  /* ── Intro ───────────────────────────────────────────────────────────────── */
  .contact-headline {
    margin-bottom: var(--sp-4);
  }

  .contact-reassurances {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
  }

  .contact-reassurance {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .reassurance-icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* ── Form wrapper ─────────────────────────────────────────────────────────── */
  .contact-form-wrapper {
    background-color: var(--card-bg);
    border-radius: var(--radius-xl);
    padding: var(--sp-8);
    box-shadow: var(--shadow-lg);
  }

  /* ── React form internals ────────────────────────────────────────────────── */
  :global(.contact-form-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    margin-bottom: var(--sp-6);
  }

  @media (max-width: 520px) {
    :global(.contact-form-grid) {
      grid-template-columns: 1fr;
    }
  }

  :global(.contact-form-message) {
    grid-column: 1 / -1;
  }

  :global(.contact-form-footer) {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  @media (min-width: 480px) {
    :global(.contact-form-footer) {
      flex-direction: row;
      align-items: center;
      gap: var(--sp-6);
    }
  }

  :global(.contact-submit) {
    flex-shrink: 0;
  }

  :global(.contact-privacy) {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    max-width: none;
    margin: 0;
    line-height: var(--leading-normal);
  }

  :global(.contact-success) {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--sp-12) var(--sp-8);
    gap: var(--sp-4);
  }

  :global(.contact-success-icon) {
    color: var(--accent);
  }

  :global(.contact-success-headline) {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--fw-semibold);
    color: var(--text-base);
    letter-spacing: var(--tracking-tight);
  }

  :global(.contact-success-message) {
    color: var(--text-secondary);
    max-width: 36ch;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  :global(.contact-error-banner) {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    background-color: rgba(192, 57, 43, 0.08);
    border-radius: var(--radius-md);
    color: #c0392b;
    font-size: var(--text-sm);
    margin-bottom: var(--sp-5);
  }

  [data-theme="dark"] :global(.contact-error-banner) {
    background-color: rgba(229, 115, 115, 0.12);
    color: #e57373;
  }

  :global(.contact-spinner) {
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
</style>
