---
/**
 * SvgIcon — single inline SVG icon set (feather-style, stroke-based).
 *
 * Replaces the previous per-section `set:html` string maps so all icons go
 * through the Astro compiler: typed markup, no raw-HTML injection. It is the
 * single source of truth for the icons used across the landing sections.
 *
 * Props:
 *  - name:      icon key (see exported `IconName`). Unknown names fall back to
 *               the "clock" icon so a bad content key never breaks the UI.
 *  - size:      pixel width/height (default 20).
 *  - strokeWidth (default 1.8)
 *  - class:     forwarded to the <svg> element (optional).
 *
 * All icons share a 24x24 viewBox, fill=none, round stroke caps/joins and
 * `stroke="currentColor"` (inherits the CSS color from the parent icon wrapper).
 */

type IconEl =
  | { e: "path"; d: string; fill?: "currentColor" }
  | { e: "circle"; cx: number; cy: number; r: number; fill?: "currentColor" }
  | { e: "line"; x1: number; y1: number; x2: number; y2: number }
  | { e: "rect"; x: number; y: number; width: number; height: number; rx?: number }
  | { e: "polyline"; points: string }
  | { e: "polygon"; points: string };

export type IconName =
  | "users" | "bed" | "bath" | "layout" | "door" | "thermometer" | "wind"
  | "wifi" | "tv" | "refrigerator" | "washer" | "dishwasher" | "microwave"
  | "coffee" | "kettle" | "toaster" | "oven" | "store" | "sun" | "trash"
