interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 20, strokeWidth = 1.8, class: className } = Astro.props;

// Unknown names fall back to the clock icon so a stray content key can't break the UI.
const body = ICONS[name] ?? ICONS.clock;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {
    body.map((el) => {
      if (el.e === "path") return (<path d={el.d} fill={el.fill ?? "none"} />);
      if (el.e === "circle") return (<circle cx={el.cx} cy={el.cy} r={el.r} fill={el.fill ?? "none"} />);
      if (el.e === "line") return (<line x1={el.x1} y1={el.y1} x2={el.x2} y2={el.y2} />);
      if (el.e === "rect") return (<rect x={el.x} y={el.y} width={el.width} height={el.height} rx={el.rx} />);
      if (el.e === "polyline") return (<polyline points={el.points} />);
      return (<polygon points={el.points} />);
    })
  }
</svg>
