---
/**
 * LocationSection — address, Google Maps embed, parking options.
 */
import type { SiteContent } from '../content/index';

interface Props {
  location: SiteContent['location'];
}

const loc = Astro.props.location;
---

<section class="section section--sky" id="ubicacion" aria-labelledby="location-title">
  <div class="container">
    <header class="location-header">
      <hr class="divider" aria-hidden="true" />
      <p class="section-label">{loc.sectionLabel}</p>
      <h2 class="section-title" id="location-title">{loc.headline}</h2>
      <p class="section-lead reveal">{loc.lead}</p>
    </header>

    <div class="location-grid">
      <!-- Map — click-to-load: no iframe (and no Google cookies) until the
           visitor asks for the map or has already accepted cookies. The
           iframe is built from these data attributes on demand, so no
           maps markup exists in the initial HTML. -->
      <div
        class="location-map reveal"
        data-map-root
        data-map-src={loc.mapEmbedUrl}
        data-map-title={loc.mapTitle}
        data-map-label={`${loc.mapTitle}: ${loc.address}`}
      >
        <div class="map-consent" data-map-placeholder>
          <p class="map-consent-note">{loc.mapConsentNote}</p>
          <button type="button" class="btn btn--primary" data-map-load>
            {loc.loadMap}
          </button>
        </div>
      </div>

      <div class="location-info">
        <!-- Parking -->
        <div class="parking reveal reveal-delay-1">
          <h3 class="parking-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <path d="M9 17V7h4a3 3 0 0 1 0 6H9"/>
            </svg>
            <span>{loc.parking.headline}</span>
          </h3>

          <ul class="parking-options" role="list">
            {loc.parking.options.map((opt, i) => (
              <li class:list={['parking-option', `reveal`, `reveal-delay-${i + 2}`]}>
                <div class="parking-option-header">
                  <span class="parking-option-name">{opt.name}</span>
                  <span class:list={['parking-badge', opt.type === 'free' ? 'parking-badge--free' : 'parking-badge--paid']}>
                    {opt.type === 'free' ? loc.parking.freeLabel : loc.parking.paidLabel}
                  </span>
                </div>
                <p class="parking-option-detail">{opt.detail}</p>
              </li>
            ))}
          </ul>

          <div class="parking-season-note" role="note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <p>{loc.parking.seasonNote}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const CONSENT_KEY = 'brisa-consent';

  function readConsent(): string | null {
    try {
      return localStorage.getItem(CONSENT_KEY);
    } catch {
      return null;
    }
  }

  function loadMap(root: Element) {
    if (root.getAttribute('data-map-loaded') === 'true') return;
    const src = root.getAttribute('data-map-src');
    // Fail fast: without an embed URL there is nothing to load.
    if (!src) return;
    root.setAttribute('data-map-loaded', 'true');
    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.width = '100%';
    iframe.height = '100%';
    iframe.style.border = '0';
    iframe.allowFullscreen = true;
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.title = root.getAttribute('data-map-title') ?? '';
    iframe.setAttribute('aria-label', root.getAttribute('data-map-label') ?? '');
    root.querySelector('[data-map-placeholder]')?.remove();
    root.appendChild(iframe);
  }

  function loadAllMaps() {
    document.querySelectorAll('[data-map-root]').forEach(loadMap);
  }

  // Prior consent (previous visit): load immediately, no click needed.
  if (readConsent() === 'accepted') {
    loadAllMaps();
  }

  // Explicit click always loads, consent or not.
  document.querySelectorAll('[data-map-load]').forEach((button) => {
    button.addEventListener('click', () => {
      const root = button.closest('[data-map-root]');
      if (root) loadMap(root);
    });
  });

  // Fresh consent via the cookie banner (same key, `brisa-consent` event
  // dispatched by BaseLayout): load without requiring a second click.
  window.addEventListener('brisa-consent', (event) => {
    if ((event as CustomEvent<string>).detail === 'accepted') {
      loadAllMaps();
    }
  });
</script>

<style>
  .section-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent-strong);
    margin-bottom: var(--sp-3);
  }

  .location-header {
    margin-bottom: var(--sp-12);
  }

  /* ── Grid ─────────────────────────────────────────────────────────────────── */
  .location-grid {
    display: grid;
    gap: var(--sp-10);
    align-items: start;
  }

  @media (min-width: 768px) {
    .location-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-12);
      align-items: start;
    }
  }

  /* ── Map ─────────────────────────────────────────────────────────────────── */
  .location-map {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    aspect-ratio: 4 / 3;
    background-color: var(--bg-surface);
  }

  .location-map iframe {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ── Click-to-load placeholder ─────────────────────────────────────────── */
  .map-consent {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    height: 100%;
    min-height: 240px;
    padding: var(--sp-6);
    text-align: center;
    background-color: var(--bg-surface-alt);
  }

  .map-consent-note {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 34ch;
    margin: 0;
  }

  /* ── Address ─────────────────────────────────────────────────────────────── */
  .location-address {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-8);
    padding: var(--sp-4) var(--sp-5);
    background-color: var(--card-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .location-pin {
    color: var(--accent);
    flex-shrink: 0;
  }

  .location-address-text {
    font-style: normal;
    font-size: var(--text-base);
    font-weight: var(--fw-medium);
    color: var(--text-base);
    line-height: var(--leading-snug);
  }

  /* ── Parking ─────────────────────────────────────────────────────────────── */
  .parking-title {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--fw-semibold);
    color: var(--text-base);
    margin-bottom: var(--sp-5);
    letter-spacing: var(--tracking-tight);
  }

  .parking-options {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
  }

  .parking-option {
    padding: var(--sp-4) var(--sp-5);
    background-color: var(--card-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .parking-option-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-bottom: var(--sp-2);
  }

  .parking-option-name {
    font-weight: var(--fw-semibold);
    font-size: var(--text-sm);
    color: var(--text-base);
  }

  .parking-badge {
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .parking-badge--free {
    background-color: rgba(42, 165, 152, 0.12);
    color: var(--color-teal-600);
  }

  [data-theme="dark"] .parking-badge--free {
    background-color: rgba(42, 165, 152, 0.2);
    color: var(--color-teal-300);
  }

  .parking-badge--paid {
    background-color: rgba(12, 31, 46, 0.08);
    color: var(--text-muted);
  }

  [data-theme="dark"] .parking-badge--paid {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
  }

  .parking-option-detail {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: none;
    margin: 0;
  }

  .parking-season-note {
    display: flex;
    gap: var(--sp-3);
    padding: var(--sp-4);
    background-color: var(--bg-surface-alt);
    border-radius: var(--radius-md);
  }

  .parking-season-note svg {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .parking-season-note p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: none;
    margin: 0;
  }
</style>
