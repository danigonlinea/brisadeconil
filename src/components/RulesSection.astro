---
/**
 * RulesSection — house rules & deposit.
 * Tone: warm, not legal fine print. No aggressive formatting.
 */
import * as content from '../content/index';
const { rules } = content;

const ruleIcons: Record<string, string> = {
  trash: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>`,
  clock: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  paw: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/></svg>`,
  'cigarette-off': `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="2" y1="2" x2="22" y2="22"/><path d="M12 12H2v4h14"/><path d="M22 12v4"/><path d="M18 12h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M7 12V7"/></svg>`,
  'volume-x': `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>`,
};
---

<section class="section section--alt" id="normas" aria-labelledby="rules-title">
  <div class="container">
    <div class="rules-grid">
      <!-- Deposit info — prominent -->
      <div class="deposit-card reveal">
        <div class="deposit-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14" rx="2"/>
            <line x1="2" y1="10" x2="22" y2="10"/>
          </svg>
        </div>
        <div>
          <p class="deposit-label" data-i18n="rules.deposit.label">{rules.deposit.label}</p>
          <p class="deposit-amount">{rules.deposit.amount}</p>
          <p class="deposit-return" data-i18n="rules.deposit.return">{rules.deposit.return}</p>
          {rules.deposit.payment && (
            <p class="deposit-payment">{rules.deposit.payment}</p>
          )}
        </div>
      </div>

      <!-- Rules list -->
      <div class="rules-content">
        <hr class="divider" aria-hidden="true" />
        <p class="section-label" data-i18n="rules.label">{rules.sectionLabel}</p>
        <p class="section-lead reveal" data-i18n="rules.lead">{rules.lead}</p>

        <ul class="rules-list reveal reveal-delay-1" role="list">
        {(() => {
          const RULE_KEYS = ['trash','checkin','pets','smoking','noise'];
          return rules.rules.map((rule: { icon: string; text: string }, ri: number) => {
            const isPending = rule.text.includes('[PENDIENTE') || rule.text.includes('[PENDING') || rule.text.includes('[AUSSTEHEND');
            return (
              <li class:list={['rule-item', isPending && 'rule-item--pending']}>
                <span class="rule-icon" set:html={ruleIcons[rule.icon] ?? ruleIcons.clock} />
                <span class="rule-text" data-i18n={`rules.rule.${RULE_KEYS[ri]}`}>
                  {isPending ? (
                    <Fragment>
                      {rule.text.replace(/\[PENDIENTE[^\]]*\]\.?|\[PENDING[^\]]*\]\.?|\[AUSSTEHEND[^\]]*\]\.?/, '')}
                      <span class="placeholder-badge" title="Dato pendiente de confirmar">Pendiente</span>
                    </Fragment>
                  ) : (
                    rule.text
                  )}
                </span>
              </li>
            );
          });
        })()}
        </ul>

        <p class="rules-placeholder-note reveal reveal-delay-2" data-i18n="rules.placeholder-note">{rules.placeholderNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .section-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-3);
  }

  .rules-headline-line { display: block; }

  /* ── Grid ─────────────────────────────────────────────────────────────────── */
  .rules-grid {
    display: grid;
    gap: var(--sp-12);
    align-items: start;
  }

  @media (min-width: 768px) {
    .rules-grid {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--sp-16);
      align-items: start;
    }
  }

  /* ── Deposit card ─────────────────────────────────────────────────────────── */
  .deposit-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    padding: var(--sp-8);
    background-color: var(--bg-dark);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    color: var(--text-on-dark);
  }

  .deposit-icon {
    color: var(--color-teal-400);
  }

  .deposit-label {
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-teal-300);
    max-width: none;
    margin-bottom: var(--sp-2);
  }

  .deposit-amount {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    font-weight: var(--fw-bold);
    color: var(--color-chalk-50);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    max-width: none;
    margin-bottom: var(--sp-3);
  }

  .deposit-return {
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    line-height: var(--leading-relaxed);
    max-width: 32ch;
  }

  .deposit-payment {
    margin-top: var(--sp-4);
    font-size: var(--text-sm);
    color: var(--text-on-dark);
    line-height: var(--leading-relaxed);
    max-width: 32ch;
  }

  /* ── Rules list ──────────────────────────────────────────────────────────── */
  .rules-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
    margin-bottom: var(--sp-5);
  }

  .rule-item {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    background-color: var(--card-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--t-fast);
  }

  .rule-item--pending {
    opacity: 0.75;
  }

  .rule-icon {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
    display: flex;
  }

  .rule-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .rules-placeholder-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    max-width: none;
    line-height: var(--leading-relaxed);
  }
</style>
