---
/**
 * RulesSection — house rules & deposit.
 * Tone: warm, not legal fine print. No aggressive formatting.
 */
import * as content from '../content/index';
import SvgIcon, { type IconName } from './SvgIcon.astro';
const { rules } = content;

---

<section class="section section--alt" id="normas" aria-labelledby="rules-title">
  <div class="container">
    <div class="rules-grid">
      <!-- Deposit info — prominent -->
      <div class="deposit-card reveal">
        <div class="deposit-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14" rx="2"/>
            <line x1="2" y1="10" x2="22" y2="10"/>
          </svg>
        </div>
        <div>
          <p class="deposit-label" data-i18n="rules.deposit.label">{rules.deposit.label}</p>
          <p class="deposit-amount">{rules.deposit.amount}</p>
          <p class="deposit-return" data-i18n="rules.deposit.return">{rules.deposit.return}</p>
          {rules.deposit.payment && (
            <p class="deposit-payment" data-i18n="rules.deposit.payment">{rules.deposit.payment}</p>
          )}
        </div>
      </div>

      <!-- Rules list -->
      <div class="rules-content">
        <hr class="divider" aria-hidden="true" />
        <p class="section-label" id="rules-title" data-i18n="rules.label">{rules.sectionLabel}</p>
        <p class="section-lead reveal" data-i18n="rules.lead">{rules.lead}</p>

        <ul class="rules-list reveal reveal-delay-1" role="list">
        {(() => {
          const RULE_KEYS = ['trash','checkin','pets','smoking','noise'];
          return rules.rules.map((rule: { icon: string; text: string }, ri: number) => {
            const isPending = rule.text.includes('[PENDIENTE') || rule.text.includes('[PENDING') || rule.text.includes('[AUSSTEHEND');
            return (
              <li class:list={['rule-item', isPending && 'rule-item--pending']}>
                <span class="rule-icon"><SvgIcon name={rule.icon as IconName} /></span>
                <span class="rule-text" data-i18n={`rules.rule.${RULE_KEYS[ri]}`}>
                  {isPending ? (
                    <Fragment>
                      {rule.text.replace(/\[PENDIENTE[^\]]*\]\.?|\[PENDING[^\]]*\]\.?|\[AUSSTEHEND[^\]]*\]\.?/, '')}
                      <span class="placeholder-badge" title="Dato pendiente de confirmar">Pendiente</span>
                    </Fragment>
                  ) : (
                    rule.text
                  )}
                </span>
              </li>
            );
          });
        })()}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .section-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent-strong);
    margin-bottom: var(--sp-3);
  }

  .rules-headline-line { display: block; }

  /* ── Grid ─────────────────────────────────────────────────────────────────── */
  .rules-grid {
    display: grid;
    gap: var(--sp-12);
    align-items: start;
  }

  @media (min-width: 768px) {
    .rules-grid {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--sp-16);
      align-items: start;
    }
  }

  /* ── Deposit card ─────────────────────────────────────────────────────────── */
  .deposit-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    padding: var(--sp-8);
    background-color: var(--bg-dark);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    color: var(--text-on-dark);
  }

  .deposit-icon {
    color: var(--color-teal-400);
  }

  .deposit-label {
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-teal-300);
    max-width: none;
    margin-bottom: var(--sp-2);
  }

  .deposit-amount {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    font-weight: var(--fw-bold);
    color: var(--color-chalk-50);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    max-width: none;
    margin-bottom: var(--sp-3);
  }

  .deposit-return {
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    line-height: var(--leading-relaxed);
    max-width: 32ch;
  }

  .deposit-payment {
    margin-top: var(--sp-4);
    font-size: var(--text-sm);
    color: var(--text-on-dark);
    line-height: var(--leading-relaxed);
    max-width: 32ch;
  }

  /* ── Rules list ──────────────────────────────────────────────────────────── */
  .rules-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
    margin-bottom: var(--sp-5);
  }

  .rule-item {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    background-color: var(--card-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--t-fast);
  }

  .rule-item--pending {
    opacity: 0.75;
  }

  .rule-icon {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
    display: flex;
  }

  .rule-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
</style>
