---
/**
 * Hero — full-viewport opening with headline copy from props.
 */
interface Props {
  hero: {
    tagline: string;
    headline: string;
    subline: string;
  };
}

const { hero } = Astro.props;
---

<section class="hero" id="hero" aria-label="Brisa de Conil">
  <div class="hero-image" role="img" aria-label="Brisa de Conil — vista del paseo y la playa de Conil de la Frontera">
    <svg class="hero-placeholder-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#0c2d48"/><stop offset="60%" stop-color="#1a4a6e"/><stop offset="100%" stop-color="#2a7090"/>
        </linearGradient>
        <linearGradient id="seaGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#1e6b8a"/><stop offset="100%" stop-color="#0c3d58"/>
        </linearGradient>
        <linearGradient id="sandGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#c8a97a"/><stop offset="100%" stop-color="#a88550"/>
        </linearGradient>
      </defs>
      <rect width="1440" height="580" fill="url(#skyGrad)"/>
      <ellipse cx="720" cy="540" rx="900" ry="60" fill="#1d7fa0" opacity="0.3"/>
      <rect y="520" width="1440" height="260" fill="url(#seaGrad)"/>
      <path d="M0 560 Q180 545 360 562 Q540 578 720 560 Q900 542 1080 560 Q1260 578 1440 560 L1440 580 Q1260 598 1080 580 Q900 562 720 580 Q540 598 360 582 Q180 565 0 580Z" fill="#1d8caa" opacity="0.4"/>
      <path d="M0 600 Q200 588 400 602 Q600 616 800 600 Q1000 584 1200 600 Q1350 612 1440 600 L1440 620 Q1350 632 1200 620 Q1000 604 800 620 Q600 636 400 622 Q200 608 0 620Z" fill="#2296b8" opacity="0.3"/>
      <rect y="720" width="1440" height="180" fill="url(#sandGrad)"/>
      <g fill="#e8f0f5" opacity="0.18">
        <rect x="100" y="480" width="60" height="70" rx="2"/>
        <rect x="155" y="495" width="45" height="55" rx="2"/>
        <rect x="195" y="470" width="55" height="80" rx="2"/>
        <rect x="1100" y="475" width="65" height="75" rx="2"/>
        <rect x="1160" y="488" width="50" height="62" rx="2"/>
        <rect x="1205" y="470" width="60" height="80" rx="2"/>
      </g>
    </svg>
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content container">
    <div class="hero-text">
      <p class="hero-tagline">{hero.tagline}</p>
      <h1 class="hero-headline">
        <span class="hero-headline-line reveal reveal-delay-1">{hero.headline.split('\n')[0]}</span><span class="hero-headline-line reveal reveal-delay-2">{hero.headline.split('\n')[1]}</span>
      </h1>
      <p class="hero-subline reveal reveal-delay-3">{hero.subline}</p>
    </div>
    <div class="hero-scroll-indicator reveal reveal-delay-5" aria-hidden="true">
      <svg width="24" height="36" viewBox="0 0 24 36" fill="none">
        <rect x="1" y="1" width="22" height="34" rx="11" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>
        <circle class="scroll-dot" cx="12" cy="10" r="3" fill="white" opacity="0.8"/>
      </svg>
    </div>
  </div>
</section>

<style is:global>
  .hero {
    position: relative; min-height: 100svh; min-height: 100vh;
    display: flex; align-items: center; overflow: hidden;
    background-color: var(--color-navy-900);
  }
  .hero-image { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .hero-placeholder-svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: none;
  }
  .hero-content {
    position: relative; z-index: 2; width: 100%;
    display: flex; flex-direction: column; justify-content: center;
    padding-top: 120px; padding-bottom: var(--sp-20);
    min-height: 100svh; min-height: 100vh;
  }
  .hero-text { max-width: 680px; }
  .hero-tagline {
    font-family: var(--font-sans); font-size: var(--text-sm);
    font-weight: var(--fw-medium); letter-spacing: var(--tracking-wider);
    text-transform: uppercase; color: var(--color-teal-300);
    margin-bottom: var(--sp-4); max-width: none; line-height: var(--leading-normal);
  }
.hero-headline {
  font-family: var(--font-serif);
  font-size: clamp(2.75rem, 7vw, var(--text-7xl));
  font-weight: var(--fw-bold);
  letter-spacing: var(--tracking-tight);
  line-height: var(--leading-tight); color: var(--color-chalk-50);
  margin-bottom: var(--sp-6);
}
  .hero-headline-line { display: inline; }
  .hero-headline-line:last-child { color: var(--color-teal-300); }
  .hero-subline {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(232,240,245,0.82); max-width: 46ch;
    line-height: var(--leading-relaxed); margin-bottom: var(--sp-10);
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--sp-4); align-items: center; }
  .hero-scroll-indicator { position: absolute; bottom: var(--sp-8); left: 50%; transform: translateX(-50%); }
  .scroll-dot { animation: scroll-bounce 2s var(--ease-out-expo) infinite; }
  @keyframes scroll-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.8; }
    50% { transform: translateY(12px); opacity: 0.3; }
  }
  .hero .reveal { opacity: 0; transform: translateY(28px); }
  .hero .reveal.visible { opacity: 1; transform: translateY(0); }
  @media (min-width: 768px) { .hero-content { padding-top: 140px; } }
</style>
