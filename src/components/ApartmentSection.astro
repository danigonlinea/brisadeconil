---
/**
 * ApartmentSection — capacity, layout, access note.
 * Impeccable: split layout (text left, specs right), no icon+heading+text card grid.
 */
import * as content from '../content/index';
import SvgIcon, { type IconName } from './SvgIcon.astro';
const { apartment, amenities } = content;

const AMENITY_KEYS = ['ac','fan','wifi','tv','hot-water','store','door','bed','coffee','kettle','fridge','freezer','washer','dishwasher','microwave','toaster','oven'];

---

<section class="section" id="apartamento" aria-labelledby="apt-title">
  <div class="container">
    <div class="apt-grid">
      <!-- Left: editorial text -->
      <div class="apt-intro reveal">
        <hr class="divider" aria-hidden="true" />
        <p class="section-label" id="apt-title" data-i18n="apt.label">{apartment.sectionLabel}</p>
      </div>

      <!-- Right: spec grid -->
      <div class="apt-specs">
        {apartment.specs.map((spec: { icon: string; label: string; value: string }, i: number) => (
          <div class:list={['apt-spec', 'reveal', `reveal-delay-${i}`, i === 0 && 'apt-spec--highlight']}>
            <div class="apt-spec-icon"><SvgIcon name={spec.icon as IconName} /></div>
            <div class="apt-spec-text">
              <div class="apt-spec-label" data-i18n={`apt.spec.${['capacity','bed','bath','layout','access','store','rooftop'][i]}.label`}>{spec.label}</div>
              <div class="apt-spec-value" data-i18n={`apt.spec.${['capacity','bed','bath','layout','access','store','rooftop'][i]}.value`}>
                {spec.icon === 'users' ? (
                  <>
                    <span class="apt-spec-value--primary">{spec.value.split(' (')[0]}</span>
                    {spec.value.includes('(') && (
                      <span class="apt-spec-value--secondary">{spec.value.slice(spec.value.indexOf('(') + 1, -1)}</span>
                    )}
                  </>
                ) : (
                  spec.value
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="apt-amenities">
      <header class="section-header">
        <hr class="divider" aria-hidden="true" />
        <p class="section-label" data-i18n="amenities.label">{amenities.sectionLabel}</p>
        <p class="section-lead reveal" data-i18n="amenities.lead">{amenities.lead}</p>
      </header>

      <ul class="amenities-grid" role="list">
        {amenities.items.map((item: { icon: string; label: string; detail: string }, i: number) => (
          <li class:list={['apt-spec', 'reveal', `reveal-delay-${(i % 4) + 1}`]}>
            <div class="apt-spec-icon"><SvgIcon name={item.icon as IconName} /></div>
            <div class="apt-spec-text">
              <span class="apt-spec-label" data-i18n={`amenities.item.${AMENITY_KEYS[i]}`}>{item.label}</span>
              {item.detail && (
                <span class="apt-spec-value" data-i18n={`amenities.item.${AMENITY_KEYS[i]}.detail`}>{item.detail}</span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .section-label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent-strong);
    margin-bottom: var(--sp-3);
  }

  .apt-headline-line { display: block; }

  /* ── Layout ──────────────────────────────────────────────────────────────── */
  .apt-grid {
    display: grid;
    gap: var(--sp-12);
    align-items: start;
  }

  /* Mantener las tarjetas de especificaciones debajo del título, igual que la sección de Equipamiento */
  @media (min-width: 768px) {
    .apt-grid {
      gap: var(--sp-12);
      align-items: start;
    }
  }

  /* ── Intro ───────────────────────────────────────────────────────────────── */
  .apt-intro {
    margin-bottom: 0;
  }

  .section-title {
    margin-bottom: var(--sp-5);
  }


  /* ── Specs grid ──────────────────────────────────────────────────────────── */
  .apt-specs {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
    margin: 0;
  }

  @media (min-width: 640px) { .apt-specs { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .apt-specs { grid-template-columns: repeat(4, 1fr); gap: 12px; } }

  .apt-amenities {
    margin-top: var(--sp-16);
  }

  .section-header {
    margin-bottom: var(--sp-12);
  }

  .amenities-grid {
    display: grid; grid-template-columns: 1fr;
    gap: var(--sp-3); padding: 0; list-style: none;
  }

  @media (min-width: 640px) { .amenities-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .amenities-grid { grid-template-columns: repeat(4, 1fr); gap: 12px; } }


  .apt-spec {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-5);
    background-color: var(--card-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--t-base), transform var(--t-base);
  }

  .apt-spec--highlight {
    background-color: var(--bg-dark);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-md);
  }

  .apt-spec--highlight .apt-spec-icon {
    background-color: var(--color-teal-400);
    color: var(--color-navy-900);
  }

  .apt-spec--highlight .apt-spec-label {
    color: var(--color-teal-200);
  }

  .apt-spec--highlight .apt-spec-value {
    color: var(--color-chalk-50);
  }

  .apt-spec:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  [data-theme="dark"] .apt-spec {
    background-color: #132d42;
    color: var(--text-on-dark);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
  }

  [data-theme="dark"] .apt-spec .apt-spec-label,
  [data-theme="dark"] .apt-spec .apt-spec-value,
  [data-theme="dark"] .apt-spec .apt-spec-value--primary {
    color: var(--text-on-dark);
  }

  [data-theme="dark"] .apt-spec .apt-spec-value--secondary {
    color: var(--text-on-dark-muted);
  }

  [data-theme="dark"] .apt-spec--highlight {
    background-color: rgba(42, 165, 152, 0.18);
    color: var(--text-on-dark);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.28);
  }

  [data-theme="dark"] .apt-spec--highlight .apt-spec-label {
    color: var(--text-on-dark);
  }

  [data-theme="dark"] .apt-spec-icon {
    background-color: #0c1f2e;
    color: var(--text-on-dark);
  }

  .apt-spec-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background-color: var(--bg-surface-alt);
    color: var(--accent);
    flex-shrink: 0;
  }

  .apt-spec-label {
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-bottom: var(--sp-1);
  }

  .apt-spec-value {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-base);
    line-height: var(--leading-snug);
  }

  .apt-spec-value--primary {
    font-size: 1.25rem;
    font-weight: var(--fw-bold);
  }

  .apt-spec-value--secondary {
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-muted);
  }

  .apt-spec--highlight .apt-spec-value--secondary {
    color: rgba(255, 255, 255, 0.82);
  }

  [data-theme="dark"] .apt-spec {
    background-color: #0c1f2e;
    color: var(--text-on-dark);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
  }

  [data-theme="dark"] .apt-spec .apt-spec-label,
  [data-theme="dark"] .apt-spec .apt-spec-value,
  [data-theme="dark"] .apt-spec .apt-spec-value--primary,
  [data-theme="dark"] .apt-spec .apt-spec-value--secondary {
    color: var(--text-on-dark);
  }

  [data-theme="dark"] .apt-spec .apt-spec-label {
    color: rgba(232, 241, 246, 0.92);
  }

  [data-theme="dark"] .apt-spec .apt-spec-value--secondary {
    color: rgba(232, 241, 246, 0.82);
  }

  [data-theme="dark"] .apt-spec-icon {
    background-color: #07131c;
    color: var(--text-on-dark);
  }

  [data-theme="dark"] .apt-spec--highlight {
    background-color: rgba(42, 165, 152, 0.16);
    color: var(--text-on-dark);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.28);
  }

  [data-theme="dark"] .apt-spec--highlight .apt-spec-label,
  [data-theme="dark"] .apt-spec--highlight .apt-spec-value,
  [data-theme="dark"] .apt-spec--highlight .apt-spec-value--secondary {
    color: var(--text-on-dark);
  }
</style>
