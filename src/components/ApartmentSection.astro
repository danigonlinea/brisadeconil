---
/**
 * ApartmentSection — capacity, layout, access note.
 * Impeccable: split layout (text left, specs right), no icon+heading+text card grid.
 */
import * as content from '../content/index';
const { apartment } = content;

// Simple inline SVG map — drawn, consistent stroke weight
const icons: Record<string, string> = {
  users: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  bed: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>`,
  bath: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><line x1="10" y1="5" x2="8" y2="7"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="7" y1="19" x2="7" y2="21"/><line x1="17" y1="19" x2="17" y2="21"/></svg>`,
  layout: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>`,
  door: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 4H3v18h18V9z"/><polyline points="13 4 13 9 18 9"/><circle cx="16" cy="14" r="1" fill="currentColor"/></svg>`,
};
---

<section class="section" id="apartamento" aria-labelledby="apt-title">
  <div class="container">
    <div class="apt-grid">
      <!-- Left: editorial text -->
      <div class="apt-intro reveal">
        <hr class="divider" aria-hidden="true" />
        <p class="section-label" data-i18n="apt.label">{apartment.sectionLabel}</p>
        <h2 class="section-title apt-headline" id="apt-title" data-i18n="apt.title">
          {apartment.headline.split('\n').map((line: string) => (
            <span class="apt-headline-line">{line}</span>
          ))}
        </h2>
        <p class="section-lead" data-i18n="apt.lead">{apartment.lead}</p>

        <div class="apt-access-note reveal reveal-delay-1">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="apt-access-icon">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <p data-i18n="apt.access-note">{apartment.accessNote}</p>
        </div>
      </div>

      <!-- Right: spec grid -->
      <dl class="apt-specs">
        {apartment.specs.map((spec: { icon: string; label: string; value: string }, i: number) => (
          <div class:list={['apt-spec', 'reveal', `reveal-delay-${i}`]}>
            <div class="apt-spec-icon" set:html={icons[spec.icon] ?? icons.door} />
            <div class="apt-spec-text">
              <dt class="apt-spec-label" data-i18n={`apt.spec.${['capacity','bed','bath','layout','access'][i]}.label`}>{spec.label}</dt>
              <dd class="apt-spec-value" data-i18n={`apt.spec.${['capacity','bed','bath','layout','access'][i]}.value`}>{spec.value}</dd>
            </div>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .section-label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-3);
  }

  .apt-headline-line { display: block; }

  /* ── Layout ──────────────────────────────────────────────────────────────── */
  .apt-grid {
    display: grid;
    gap: var(--sp-16);
    align-items: start;
  }

  @media (min-width: 768px) {
    .apt-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-20);
      align-items: center;
    }
  }

  /* ── Intro ───────────────────────────────────────────────────────────────── */
  .apt-intro {
    /* divider + label above heading = more space above than below; heading margin provides space below */
  }

  .section-title {
    margin-bottom: var(--sp-5);
  }

  .apt-access-note {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    margin-top: var(--sp-8);
    padding: var(--sp-4) var(--sp-5);
    background-color: var(--bg-surface-alt);
    border-radius: var(--radius-lg);
  }

  .apt-access-note p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: none;
    margin: 0;
  }

  .apt-access-icon {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ── Specs grid ──────────────────────────────────────────────────────────── */
  .apt-specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
    margin: 0;
  }

  .apt-spec {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-5);
    background-color: var(--card-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--t-base), transform var(--t-base);
  }

  .apt-spec:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .apt-spec-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background-color: var(--bg-surface-alt);
    color: var(--accent);
    flex-shrink: 0;
  }

  .apt-spec-label {
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-bottom: var(--sp-1);
  }

  .apt-spec-value {
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-base);
    line-height: var(--leading-snug);
  }
</style>
