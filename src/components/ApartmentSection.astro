---
/**
 * ApartmentSection — capacity, layout, access note.
 * Impeccable: split layout (text left, specs right), no icon+heading+text card grid.
 */
import { getContent, type Locale } from '../content/index';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const content = await getContent(locale);
const { apartment, amenities } = content;

const AMENITY_KEYS = ['ac','fan','wifi','tv','hot-water','store','door','bed','coffee','kettle','fridge','freezer','washer','dishwasher','microwave','toaster','oven'];

// Simple inline SVG map — drawn, consistent stroke weight
const icons: Record<string, string> = {
  users: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  bed: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>`,
  bath: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><line x1="10" y1="5" x2="8" y2="7"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="7" y1="19" x2="7" y2="21"/><line x1="17" y1="19" x2="17" y2="21"/></svg>`,
  layout: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>`,
  door: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 4H3v18h18V9z"/><polyline points="13 4 13 9 18 9"/><circle cx="16" cy="14" r="1" fill="currentColor"/></svg>`,
  thermometer: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/></svg>`,
  wind: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/><path d="M9.6 4.6A2 2 0 1 1 11 8H2"/><path d="M12.6 19.4A2 2 0 1 0 14 16H2"/></svg>`,
  wifi: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>`,
  tv: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="15" rx="2"/><polyline points="17 2 12 7 7 2"/></svg>`,
  refrigerator: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="4" y1="10" x2="20" y2="10"/><line x1="9" y1="6" x2="9" y2="8"/><line x1="9" y1="14" x2="9" y2="18"/></svg>`,
  washer: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="2"/><circle cx="12" cy="13" r="4"/><path d="M6 6h.01M10 6h.01"/></svg>`,
  dishwasher: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M7 7v10M12 7v10M17 7v10"/><line x1="4" y1="12" x2="20" y2="12"/></svg>`,
  microwave: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><rect x="8" y="9" width="8" height="6" rx="1"/><circle cx="18" cy="12" r="1" fill="currentColor"/></svg>`,
  coffee: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 4.8v-1.3"/><path d="M8.6 4.8h3.4l2 5H7.2z"/><path d="M7.2 10.1h6.6"/><path d="M7 10.3h7l-.9 7.9h-5.2z"/><path d="M13.6 6.9c3.1 0 4.7 1 4.7 2.1s-1.4 1.9-4.5 2.1"/></svg>`,
  kettle: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.2 3.6c-.5.6-.5 1.3 0 1.9"/><path d="M6 2.6c.5.6.5 1.2 0 1.8"/><path d="M6.9 9.6c-1.7 0-2.9-1-3.1-2.4"/><path d="M6.5 9.5h8l.9 7.6a.9.9 0 0 1-.9.9H6.5a.9.9 0 0 1-.9-.9z"/><path d="M7.2 12h6.4"/><path d="M14.8 8.6c3 0 4.6 1.1 4.6 2.3 0 1.1-1.5 2.2-4.4 2.4"/></svg>`,
  toaster: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="7" width="14" height="10" rx="2"/><line x1="7" y1="11" x2="17" y2="11"/><line x1="9" y1="7" x2="9" y2="5"/><line x1="15" y1="7" x2="15" y2="5"/></svg>`,
  oven: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="7" y="8" width="10" height="6" rx="1"/><circle cx="9.5" cy="17" r="1" fill="currentColor"/><circle cx="14.5" cy="17" r="1" fill="currentColor"/></svg>`,
  store: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h18"/><path d="M5 8l1.5-4h11L19 8"/><path d="M5 8v11h14V8"/><path d="M8 12h8"/></svg>`,
  sun: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="M4.93 4.93l1.41 1.41"/><path d="M17.66 17.66l1.41 1.41"/><path d="M4.93 19.07l1.41-1.41"/><path d="M17.66 6.34l1.41-1.41"/></svg>`,
};
---

<section class="section" id="apartamento" aria-labelledby="apt-title">
  <div class="container">
    <div class="apt-grid">
      <!-- Left: editorial text -->
      <div class="apt-intro reveal">
        <hr class="divider" aria-hidden="true" />
        <p class="section-label" id="apt-title" data-i18n="apt.label">{apartment.sectionLabel}</p>
      </div>

      <!-- Right: spec grid -->
      <dl class="apt-specs">
        {apartment.specs.map((spec: { icon: string; label: string; value: string }, i: number) => (
          <div class:list={['apt-spec', 'reveal', `reveal-delay-${i}`, i === 0 && 'apt-spec--highlight']}>
            <div class="apt-spec-icon" set:html={icons[spec.icon] ?? icons.door} />
            <div class="apt-spec-text">
              <dt class="apt-spec-label" data-i18n={`apt.spec.${['capacity','bed','bath','layout','access','store','rooftop'][i]}.label`}>{spec.label}</dt>
              <dd class="apt-spec-value" data-i18n={`apt.spec.${['capacity','bed','bath','layout','access','store','rooftop'][i]}.value`}>
                {spec.icon === 'users' ? (
                  <>
                    <span class="apt-spec-value--primary">{spec.value.split(' (')[0]}</span>
                    {spec.value.includes('(') && (
                      <span class="apt-spec-value--secondary">{spec.value.slice(spec.value.indexOf('(') + 1, -1)}</span>
                    )}
                  </>
                ) : (
                  spec.value
                )}
              </dd>
            </div>
          </div>
        ))}
      </dl>
    </div>

    <div class="apt-amenities">
      <header class="section-header">
        <hr class="divider" aria-hidden="true" />
        <p class="section-label" data-i18n="amenities.label">{amenities.sectionLabel}</p>
        <p class="section-lead reveal" data-i18n="amenities.lead">{amenities.lead}</p>
      </header>

      <ul class="amenities-grid" role="list">
        {amenities.items.map((item: { icon: string; label: string; detail: string }, i: number) => (
          <li class:list={['apt-spec', 'reveal', `reveal-delay-${(i % 4) + 1}`]}>
            <div class="apt-spec-icon" set:html={icons[item.icon] ?? icons.wifi} />
            <div class="apt-spec-text">
              <span class="apt-spec-label" data-i18n={`amenities.item.${AMENITY_KEYS[i]}`}>{item.label}</span>
              {item.detail && (
                <span class="apt-spec-value" data-i18n={`amenities.item.${AMENITY_KEYS[i]}.detail`}>{item.detail}</span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .section-label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-3);
  }

  .apt-headline-line { display: block; }

  /* ── Layout ──────────────────────────────────────────────────────────────── */
  .apt-grid {
    display: grid;
    gap: var(--sp-12);
    align-items: start;
  }

  /* Mantener las tarjetas de especificaciones debajo del título, igual que la sección de Equipamiento */
  @media (min-width: 768px) {
    .apt-grid {
      gap: var(--sp-12);
      align-items: start;
    }
  }

  /* ── Intro ───────────────────────────────────────────────────────────────── */
  .apt-intro {
    margin-bottom: 0;
  }

  .section-title {
    margin-bottom: var(--sp-5);
  }


  /* ── Specs grid ──────────────────────────────────────────────────────────── */
  .apt-specs {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
    margin: 0;
  }

  @media (min-width: 640px) { .apt-specs { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .apt-specs { grid-template-columns: repeat(4, 1fr); gap: 12px; } }

  .apt-amenities {
    margin-top: var(--sp-16);
  }

  .section-header {
    margin-bottom: var(--sp-12);
  }

  .amenities-grid {
    display: grid; grid-template-columns: 1fr;
    gap: var(--sp-3); padding: 0; list-style: none;
  }

  @media (min-width: 640px) { .amenities-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .amenities-grid { grid-template-columns: repeat(4, 1fr); gap: 12px; } }


  .apt-spec {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-5);
    background-color: var(--card-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--t-base), transform var(--t-base);
  }

  .apt-spec--highlight {
    background-color: var(--bg-dark);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-md);
  }

  .apt-spec--highlight .apt-spec-icon {
    background-color: var(--color-teal-400);
    color: var(--color-navy-900);
  }

  .apt-spec--highlight .apt-spec-label {
    color: var(--color-teal-200);
  }

  .apt-spec--highlight .apt-spec-value {
    color: var(--color-chalk-50);
  }

  .apt-spec:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  [data-theme="dark"] .apt-spec {
    background-color: #132d42;
    color: var(--text-on-dark);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
  }

  [data-theme="dark"] .apt-spec .apt-spec-label,
  [data-theme="dark"] .apt-spec .apt-spec-value,
  [data-theme="dark"] .apt-spec .apt-spec-value--primary {
    color: var(--text-on-dark);
  }

  [data-theme="dark"] .apt-spec .apt-spec-value--secondary {
    color: var(--text-on-dark-muted);
  }

  [data-theme="dark"] .apt-spec--highlight {
    background-color: rgba(42, 165, 152, 0.18);
    color: var(--text-on-dark);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.28);
  }

  [data-theme="dark"] .apt-spec--highlight .apt-spec-label {
    color: var(--text-on-dark);
  }

  [data-theme="dark"] .apt-spec-icon {
    background-color: #0c1f2e;
    color: var(--text-on-dark);
  }

  .apt-spec-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background-color: var(--bg-surface-alt);
    color: var(--accent);
    flex-shrink: 0;
  }

  .apt-spec-label {
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-bottom: var(--sp-1);
  }

  .apt-spec-value {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-base);
    line-height: var(--leading-snug);
  }

  .apt-spec-value--primary {
    font-size: 1.25rem;
    font-weight: var(--fw-bold);
  }

  .apt-spec-value--secondary {
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-muted);
  }

  .apt-spec--highlight .apt-spec-value--secondary {
    color: rgba(255, 255, 255, 0.82);
  }

  [data-theme="dark"] .apt-spec {
    background-color: #0c1f2e;
    color: var(--text-on-dark);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
  }

  [data-theme="dark"] .apt-spec .apt-spec-label,
  [data-theme="dark"] .apt-spec .apt-spec-value,
  [data-theme="dark"] .apt-spec .apt-spec-value--primary,
  [data-theme="dark"] .apt-spec .apt-spec-value--secondary {
    color: var(--text-on-dark);
  }

  [data-theme="dark"] .apt-spec .apt-spec-label {
    color: rgba(232, 241, 246, 0.92);
  }

  [data-theme="dark"] .apt-spec .apt-spec-value--secondary {
    color: rgba(232, 241, 246, 0.82);
  }

  [data-theme="dark"] .apt-spec-icon {
    background-color: #07131c;
    color: var(--text-on-dark);
  }

  [data-theme="dark"] .apt-spec--highlight {
    background-color: rgba(42, 165, 152, 0.16);
    color: var(--text-on-dark);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.28);
  }

  [data-theme="dark"] .apt-spec--highlight .apt-spec-label,
  [data-theme="dark"] .apt-spec--highlight .apt-spec-value,
  [data-theme="dark"] .apt-spec--highlight .apt-spec-value--secondary {
    color: var(--text-on-dark);
  }
</style>
