---
/**
 * ConilSection — "Qué hacer en Conil"
 * Brief: visually secondary, doesn't compete with conversion sections.
 * Uses a collapsible accordion-style with 3 categories.
 */
import { getContent, type Locale } from '../content/index';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const content = await getContent(locale);
const { conil } = content;

const categoryIcons: Record<string, string> = {
  waves: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></svg>`,
  landmark: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>`,
  utensils: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>`,
};
---

<section class="section conil-section" id="conil" aria-labelledby="conil-title">
  <div class="container">
    <header class="conil-header reveal">
      <hr class="divider" aria-hidden="true" />
      <p class="section-label" data-i18n="conil.label">{conil.sectionLabel}</p>
      <h2 class="section-title" id="conil-title" data-i18n="conil.title">{conil.headline}</h2>
      <p class="section-lead" data-i18n="conil.lead">{conil.lead}</p>
    </header>

    <div class="conil-categories">
      {(() => {
        const CAT_KEYS = ['beaches','oldtown','food'];
        return conil.categories.map((cat: { icon: string; title: string; items: string[] }, i: number) => (
          <div class:list={['conil-category', 'reveal', `reveal-delay-${i + 1}`]}>
            <div class="conil-category-header">
              <span class="conil-category-icon" set:html={categoryIcons[cat.icon] ?? categoryIcons.waves} />
              <h3 class="conil-category-title" data-i18n={`conil.${CAT_KEYS[i]}.title`}>{cat.title}</h3>
            </div>
            <ul class="conil-category-items" role="list">
              {cat.items.map((item: string) => (
                <li class="conil-item">
                  <span class="conil-item-dot" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ));
      })()}
    </div>
  </div>
</section>

<style>
  /* Deliberately quieter section — smaller type, less contrast */
  .conil-section {
    background-color: var(--bg-base);
  }

  .section-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-3);
  }

  .conil-header {
    margin-bottom: var(--sp-10);
  }

  /* ── Categories ──────────────────────────────────────────────────────────── */
  .conil-categories {
    display: grid;
    gap: var(--sp-6);
    margin-bottom: var(--sp-8);
  }

  @media (min-width: 640px) {
    .conil-categories {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .conil-category {
    padding: var(--sp-6);
    background-color: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .conil-category-header {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  .conil-category-icon {
    color: var(--accent);
    display: flex;
    flex-shrink: 0;
  }

  .conil-category-title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--fw-semibold);
    color: var(--text-base);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .conil-category-items {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .conil-item {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .conil-item-dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
    flex-shrink: 0;
    margin-top: 6px;
  }
</style>
