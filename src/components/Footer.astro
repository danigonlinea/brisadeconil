---
/**
 * Footer — brand, address, nav links, legal.
 */
import * as content from '../content/index';
const { footer, nav } = content;
const base = import.meta.env.BASE_URL ?? '/';
const legalHref = `${base}aviso-legal`;
const privacyHref = `${base}politica-privacidad`;
const cookiesHref = `${base}politica-cookies`;
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-brand-col">
        <a href="#" class="footer-brand" aria-label="Brisa de Conil — volver al inicio">
          <svg width="24" height="24" viewBox="0 0 28 28" fill="none" aria-hidden="true" class="footer-brand-icon">
            <path d="M4 18 C8 14, 12 10, 14 14 C16 18, 20 22, 24 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/>
            <path d="M4 22 C8 18, 12 16, 16 18 C19 19.5, 22 22, 24 22" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" opacity="0.55"/>
          </svg>
          <span class="footer-brand-name">{footer.brand}</span>
        </a>
        <p class="footer-tagline" data-i18n="footer.tagline">{footer.tagline}</p>
        <address class="footer-address">
          {footer.address.split('\n').map((line: string, i: number) => (
            <span key={i}>
              {line}
              {i < footer.address.split('\n').length - 1 && <br />}
            </span>
          ))}
        </address>
      </div>

      <!-- Nav column -->
      <nav class="footer-nav" aria-label="Navegación pie de página">
        <p class="footer-nav-title" data-i18n="footer.sections">Secciones</p>
        <ul role="list">
          <li><a href="#apartamento" class="footer-nav-link" data-i18n="footer.link.apartamento">{footer.links[0]?.label ?? 'El apartamento'}</a></li>
          <li><a href="#galeria"     class="footer-nav-link" data-i18n="footer.link.galeria">{footer.links[1]?.label ?? 'Galería'}</a></li>
          <li><a href="#ubicacion"   class="footer-nav-link" data-i18n="footer.link.ubicacion">{footer.links[2]?.label ?? 'Ubicación'}</a></li>
          <li><a href="#contacto"    class="footer-nav-link" data-i18n="footer.link.contacto">{footer.links[3]?.label ?? 'Contacto'}</a></li>
          <li><a href="#faq"         class="footer-nav-link" data-i18n="footer.link.faq">{footer.links[4]?.label ?? 'FAQ'}</a></li>
        </ul>
      </nav>

      <!-- Contact column -->
      <div class="footer-contact-col">
        <p class="footer-nav-title" data-i18n="contact.label">Contacto</p>
        <a href="#contacto" class="btn btn--primary btn--sm footer-cta" data-i18n="nav.cta">
          {nav.cta}
        </a>
        <p class="footer-response-note" data-i18n="footer.response-note">
          Respondemos normalmente en el mismo día.
        </p>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-legal" data-i18n="footer.legal">{footer.legalNote}</p>
      <div class="footer-legal-links">
        <a href={legalHref} class="footer-legal-link" data-i18n="footer.legal-link">{footer.legalLabel}</a>
        <a href={privacyHref} class="footer-legal-link" data-i18n="footer.privacy-link">{footer.privacyLabel}</a>
        <a href={cookiesHref} class="footer-legal-link" data-i18n="footer.cookies-link">{footer.cookiesLabel}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-dark);
    color: var(--text-on-dark);
    padding-block: var(--sp-16) var(--sp-10);
  }

  /* ── Grid ─────────────────────────────────────────────────────────────────── */
  .footer-grid {
    display: grid;
    gap: var(--sp-10);
    margin-bottom: var(--sp-12);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--sp-12);
    }
  }

  /* ── Brand ───────────────────────────────────────────────────────────────── */
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    text-decoration: none;
    color: var(--text-on-dark);
    margin-bottom: var(--sp-4);
  }

  .footer-brand:hover { text-decoration: none; color: var(--color-chalk-50); }

  .footer-brand-icon { color: var(--color-teal-400); }

  .footer-brand-name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    max-width: 28ch;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--sp-4);
  }

  .footer-address {
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    line-height: var(--leading-relaxed);
  }

  /* ── Nav ─────────────────────────────────────────────────────────────────── */
  .footer-nav-title {
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-teal-400);
    margin-bottom: var(--sp-4);
    max-width: none;
  }

  .footer-nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .footer-nav-link {
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    text-decoration: none;
    transition: color var(--t-fast);
  }

  .footer-nav-link:hover { color: var(--color-chalk-50); }

  /* ── Contact col ─────────────────────────────────────────────────────────── */
  .footer-cta { margin-top: var(--sp-2); margin-bottom: var(--sp-4); }

  .footer-response-note {
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
    max-width: 24ch;
    line-height: var(--leading-relaxed);
  }

  /* ── Bottom bar ──────────────────────────────────────────────────────────── */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--color-navy-700);
  }

  .footer-legal {
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
    max-width: none;
    margin: 0;
  }

  .footer-legal-links {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .footer-legal-link {
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--t-fast);
  }

  .footer-legal-link:hover { color: var(--color-chalk-50); }
</style>
