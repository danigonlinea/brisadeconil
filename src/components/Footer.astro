---
/**
 * Footer — brand, address, nav links, legal.
 */
import type { SiteContent } from '../content/index';
import { DEFAULT_LOCALE, homePath, routePrefix, type Locale } from '../i18n/locales';

interface Props {
  footer: SiteContent['footer'];
  cta: string;
  /** Label for the Blog link shown next to the legal links (content.blog.navLabel). Omit to hide it. */
  blogLabel?: string;
  /** Locale whose homepage the section anchors (#apartamento…) point to. */
  locale?: Locale;
}

const { footer, cta, blogLabel, locale = DEFAULT_LOCALE } = Astro.props;
const base = import.meta.env.BASE_URL ?? '/';
function createLegalHref(path: string) {
  return `${base.replace(/\/$/, '')}/${path.replace(/^\//, '').replace(/\/$/, '')}/`;
}
/** Section anchors always target the locale homepage so they keep working off-home (e.g. /blog/). */
function sectionHref(href: string) {
  return href.startsWith('#') ? `${base.replace(/\/$/, '')}${homePath(locale)}${href}` : href;
}
const legalHref = createLegalHref('aviso-legal');
const privacyHref = createLegalHref('politica-privacidad');
const cookiesHref = createLegalHref('politica-cookies');
// Trailing slash kept so it matches the header nav item and the canonical URL.
// Locale-prefixed so /en/ and /de/ link to their own blog, not the Spanish one.
const blogHref = `${base.replace(/\/$/, '')}${routePrefix(locale)}/blog/`;
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-brand-col">
        <a href="#" class="footer-brand" aria-label="Brisa de Conil — volver al inicio">
          <svg width="24" height="24" viewBox="0 0 28 28" fill="none" aria-hidden="true" class="footer-brand-icon">
            <path d="M4 18 C8 14, 12 10, 14 14 C16 18, 20 22, 24 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/>
            <path d="M4 22 C8 18, 12 16, 16 18 C19 19.5, 22 22, 24 22" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" opacity="0.55"/>
          </svg>
          <span class="footer-brand-name">{footer.brand}</span>
        </a>
        <p class="footer-tagline">{footer.tagline}</p>
        <address class="footer-address">
          {footer.address.split('\n').map((line: string, i: number) => (
            <span>
              {line}
              {i < footer.address.split('\n').length - 1 && <br />}
            </span>
          ))}
        </address>

        <div class="footer-socials">
          <a
            href="https://www.instagram.com/brisadeconil/"
            class="footer-social"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de Brisa de Conil"
          >
            <svg
              class="footer-social-icon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
            <span class="footer-social-label">@brisadeconil</span>
          </a>

          <a
            href="https://www.facebook.com/profile.php?id=61592924126300"
            class="footer-social"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook de Brisa de Conil"
          >
            <svg
              class="footer-social-icon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
            </svg>
            <span class="footer-social-label">Brisa de Conil</span>
          </a>
        </div>
      </div>

      <!-- Nav column -->
      <nav class="footer-nav" aria-label="Navegación pie de página">
        <p class="footer-nav-title">Secciones</p>
        <ul role="list">
          {footer.links.map((link) => (
            <li><a href={sectionHref(link.href)} class="footer-nav-link">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Contact column -->
      <div class="footer-contact-col">
        <p class="footer-nav-title">Contacto</p>
        <a href={sectionHref('#contacto')} class="btn btn--primary btn--sm footer-cta">
          {cta}
        </a>
        <p class="footer-response-note">{footer.responseNote}</p>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-legal">{footer.legalNote}</p>
      <div class="footer-legal-links">
        {blogLabel && <a href={blogHref} class="footer-legal-link">{blogLabel}</a>}
        <a href={legalHref} class="footer-legal-link">{footer.legalLabel}</a>
        <a href={privacyHref} class="footer-legal-link">{footer.privacyLabel}</a>
        <a href={cookiesHref} class="footer-legal-link">{footer.cookiesLabel}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-dark);
    color: var(--text-on-dark);
    padding-block: var(--sp-16) var(--sp-10);
  }

  /* ── Grid ─────────────────────────────────────────────────────────────────── */
  .footer-grid {
    display: grid;
    gap: var(--sp-10);
    margin-bottom: var(--sp-12);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--sp-12);
    }
  }

  /* ── Brand ───────────────────────────────────────────────────────────────── */
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    text-decoration: none;
    color: var(--text-on-dark);
    margin-bottom: var(--sp-4);
  }

  .footer-brand:hover { text-decoration: none; color: var(--color-chalk-50); }

  .footer-brand-icon { color: var(--color-teal-400); }

  .footer-brand-name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    max-width: 28ch;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--sp-4);
  }

  .footer-address {
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    line-height: var(--leading-relaxed);
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-5);
    margin-top: var(--sp-4);
  }

  .footer-social {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--t-fast);
  }

  .footer-social:hover { color: var(--color-chalk-50); text-decoration: none; }

  .footer-social-icon {
    display: block;
    color: var(--color-teal-400);
    transition: color var(--t-fast);
  }

  .footer-social:hover .footer-social-icon { color: var(--color-teal-300); }

  /* ── Nav ─────────────────────────────────────────────────────────────────── */
  .footer-nav-title {
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-teal-400);
    margin-bottom: var(--sp-4);
    max-width: none;
  }

  .footer-nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .footer-nav-link {
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    text-decoration: none;
    transition: color var(--t-fast);
  }

  .footer-nav-link:hover { color: var(--color-chalk-50); }

  /* ── Contact col ─────────────────────────────────────────────────────────── */
  .footer-cta { margin-top: var(--sp-2); margin-bottom: var(--sp-4); }

  .footer-response-note {
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
    max-width: 24ch;
    line-height: var(--leading-relaxed);
  }

  /* ── Bottom bar ──────────────────────────────────────────────────────────── */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--color-navy-700);
  }

  .footer-legal {
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
    max-width: none;
    margin: 0;
  }

  .footer-legal-links {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .footer-legal-link {
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--t-fast);
  }

  .footer-legal-link:hover { color: var(--color-chalk-50); }
</style>
