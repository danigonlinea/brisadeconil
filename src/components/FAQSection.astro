---
/**
 * FAQSection — wraps FAQAccordion React island.
 */
import type { SiteContent } from '../content/index';

interface Props {
  faq: SiteContent['faq'];
}

const { faq } = Astro.props;

// FAQPage structured data for answer engines (generated from content).
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items
    .filter((item) => !item.pending)
    .map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
};
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq-container">
    <header class="faq-header reveal">
      <hr class="divider" aria-hidden="true" />
      <p class="section-label">{faq.sectionLabel}</p>
      <h2 class="section-title" id="faq-title">{faq.headline}</h2>
    </header>

    <div class="faq-body reveal reveal-delay-1">
      <div class="faq-list">
        {faq.items.map((item) => (
          <details class="faq-item">
            <summary class="faq-trigger">
              <span class="faq-question">{item.q}</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </span>
            </summary>
            <div class="faq-panel">
              <div class="faq-answer">
                {item.pending ? (
                  <span class="faq-pending">
                    <span>{item.a.replace(/\[PENDIENTE[^\]]*\]\.?/, '').trim()}</span>{' '}
                    <span class="placeholder-badge">{faq.pendingBadge}</span>
                  </span>
                ) : (
                  <span>{item.a}</span>
                )}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>

  <!-- Schema.org — FAQPage (answer engines) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .section-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-3);
  }

  .faq-container {
    max-width: var(--container-md);
  }

  .faq-header {
    margin-bottom: var(--sp-10);
  }

  /* FAQ list styles (pure HTML details/summary) */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .faq-item {
    background-color: var(--card-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: box-shadow var(--t-base);
  }

  .faq-item[open] {
    box-shadow: var(--shadow-md);
  }

  .faq-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    width: 100%;
    padding: var(--sp-5) var(--sp-6);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background-color var(--t-fast);
    list-style: none;
  }

  .faq-trigger::-webkit-details-marker {
    display: none;
  }

  .faq-trigger:hover {
    background-color: var(--bg-surface-alt);
  }

  .faq-trigger:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
    border-radius: var(--radius-lg);
  }

  .faq-question {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: var(--fw-semibold);
    color: var(--text-base);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .faq-chevron {
    color: var(--accent);
    flex-shrink: 0;
    display: flex;
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-panel {
    padding: 0 var(--sp-6) var(--sp-5);
  }

  .faq-answer {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2);
  }

  .faq-pending {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2);
  }
</style>
