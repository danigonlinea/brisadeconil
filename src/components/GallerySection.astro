---
/**
 * GallerySection — PhotoSwipe lightbox as a React island.
 * Placeholders clearly marked for real photography.
 */
import GalleryIsland from './GalleryIsland';
// PhotoSwipe's stylesheet must be imported statically here: a dynamic
// `import('photoswipe/style.css')` inside the island makes Vite emit the CSS
// URL into the chunk while Astro's build never emits the file itself, so the
// lightbox would render unstyled (404) in production.
import 'photoswipe/dist/photoswipe.css';
---

<section class="section section--alt" id="galeria" aria-labelledby="gallery-title">
  <div class="container">
    <header class="gallery-header">
      <hr class="divider" aria-hidden="true" />
      <p class="section-label" id="gallery-title" data-i18n="gallery.label">Galería de fotos</p>
      <p class="section-lead reveal" data-i18n="gallery.lead">
        Un vistazo a cada rincón con luz natural y el ambiente auténtico del apartamento.
      </p>
    </header>

    <!-- React island — PhotoSwipe loads client-side only -->
    <GalleryIsland client:visible />
  </div>
</section>

<style>
  .section-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent-strong);
    margin-bottom: var(--sp-3);
  }

  .gallery-header {
    margin-bottom: var(--sp-10);
  }
</style>
