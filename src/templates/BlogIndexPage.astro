---
/**
 * BlogIndexPage — blog listing for one locale.
 *
 * Posts live in one collection per locale (blog / blogEn / blogDe) so each
 * language ships its own markdown files and slugs. Pages under src/pages are
 * thin wrappers: /blog/ (es), /en/blog/, /de/blog/.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { CONTENT } from '../content/index';
import { DEFAULT_LOCALE, homePath, routePrefix, SUPPORTED_LOCALES, type Locale } from '../i18n/locales';
import { blogCollectionFor, blogLocaleTag } from '../i18n/blog';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const blog = CONTENT[locale].blog;
const brand = CONTENT[locale].footer.brand;

// Newest first; a stable copy so we never mutate the collection result.
const posts = (await getCollection(blogCollectionFor(locale))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const siteUrl = import.meta.env.SITE ?? 'https://www.brisadeconil.com';
const base = import.meta.env.BASE_URL ?? '/';
const prefix = `${base.replace(/\/$/, '')}${routePrefix(locale)}`;
const rootHref = `${base.replace(/\/$/, '')}${homePath(locale)}`;
const blogHref = `${prefix}/blog/`;
const canonical = `${siteUrl}${routePrefix(locale)}/blog/`;
// The listing exists in every locale at the same relative path.
const hreflangs = [
  ...SUPPORTED_LOCALES.map((l) => ({
    lang: l,
    href: `${siteUrl}${routePrefix(l)}/blog/`,
  })),
  { lang: 'x-default' as const, href: `${siteUrl}/blog/` },
];

const dateFormatter = new Intl.DateTimeFormat(blogLocaleTag(locale), {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Structured data — BreadcrumbList (Home → Blog). The last crumb is the
// page itself, so it omits "item" per schema.org guidance.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: blog.breadcrumbHome,
      item: new URL(rootHref, siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: blog.navLabel,
    },
  ],
};
---

<BaseLayout locale={locale} title={blog.metaTitle} description={blog.description} canonicalUrl={canonical} hreflangs={hreflangs}>
  {/* Schema.org — BreadcrumbList */}
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <header class="blog-topbar">
    <div class="container blog-topbar-inner">
      <a href={rootHref} class="blog-brand">{brand}</a>
      <a href={rootHref} class="blog-backlink">← {blog.backToHome}</a>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <section class="blog-listing">
      <div class="container">
        <span class="section-accent-line" aria-hidden="true"></span>
        <h1 class="section-title">{blog.heading}</h1>
        <p class="section-lead">{blog.lead}</p>

        {posts.length === 0 ? (
          <div class="blog-empty">
            <h2>{blog.emptyTitle}</h2>
            <p>{blog.emptyBody}</p>
          </div>
        ) : (
          <ul class="blog-grid" role="list" data-blog-index>
            {posts.map((post, index) => (
              <li class="blog-card">
                <a
                  href={`${blogHref}${post.id}/`}
                  class="blog-card-link"
                  data-blog-card
                  data-post-slug={post.id}
                  data-post-title={post.data.title}
                  data-post-position={index + 1}
                >
                  <time class="blog-card-date" datetime={post.data.pubDate.toISOString()}>
                    {dateFormatter.format(post.data.pubDate)}
                  </time>
                  <h2 class="blog-card-title">{post.data.title}</h2>
                  <p class="blog-card-description">{post.data.description}</p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <ul class="tag-list" role="list">
                      {post.data.tags.map((tag) => <li class="tag-chip">{tag}</li>)}
                    </ul>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )}

        <!-- Internal links to the keyword landings, so they are reachable
             from navigable content and not only from the sitemap. The
             landings are Spanish-only, so they are omitted elsewhere. -->
        {locale === DEFAULT_LOCALE && (
          <nav class="blog-related" aria-label={blog.relatedLabel}>
            <h2>{blog.relatedLabel}</h2>
            <ul role="list">
              <li><a href={`${base.replace(/\/$/, '')}/apartamento-vacacional-conil/`}>Apartamento vacacional en Conil de la Frontera</a></li>
              <li><a href={`${base.replace(/\/$/, '')}/alojamiento-cerca-playa-conil/`}>Alojamiento a 8-10 minutos de la playa en Conil</a></li>
            </ul>
          </nav>
        )}
      </div>
    </section>
  </main>

  <Footer footer={CONTENT[locale].footer} cta={CONTENT[locale].nav.cta} blogLabel={blog.navLabel} locale={locale} />

  {/* Blog index analytics: card clicks */}
  <script is:inline>
    (function () {
      const grid = document.querySelector('[data-blog-index]');
      if (!grid) return;
      grid.addEventListener('click', function (e) {
        const card = e.target.closest('[data-blog-card]');
        if (!card) return;
        if (window.gtag) {
          window.gtag('event', 'blog_card_click', {
            slug: card.dataset.postSlug,
            title: card.dataset.postTitle,
            position: parseInt(card.dataset.postPosition, 10),
          });
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .blog-listing {
    padding-block: var(--sp-12) var(--sp-20);
  }

  /* ── Related landings ────────────────────────────────────────────────────── */
  .blog-related {
    margin-top: var(--sp-12);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--border-subtle);
  }

  .blog-related h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--sp-4);
  }

  .blog-related ul {
    display: grid;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-related a {
    color: var(--accent-strong);
  }

  @media (min-width: 768px) {
    .blog-listing {
      padding-block: var(--sp-16) var(--sp-24);
    }
  }

  /* ── Top bar ─────────────────────────────────────────────────────────────── */
  .blog-topbar {
    background-color: var(--bg-dark);
  }

  .blog-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    height: 64px;
  }

  .blog-brand {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-on-dark);
    text-decoration: none;
    transition: color var(--t-fast);
  }

  .blog-brand:hover {
    color: var(--color-teal-400);
    text-decoration: none;
  }

  .blog-backlink {
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    text-decoration: none;
    transition: color var(--t-fast);
  }

  .blog-backlink:hover {
    color: var(--text-on-dark);
    text-decoration: underline;
  }

  /* ── Empty state ─────────────────────────────────────────────────────────── */
  .blog-empty {
    max-width: 36rem;
    margin-inline: auto;
    margin-top: var(--sp-12);
    padding: var(--sp-12) var(--sp-8);
    text-align: center;
    background-color: var(--card-bg);
    border: 2px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .blog-empty h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--sp-3);
  }

  .blog-empty p {
    margin-inline: auto;
    color: var(--text-secondary);
  }

  /* ── Cards grid ──────────────────────────────────────────────────────────── */
  .blog-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-6);
    margin-top: var(--sp-10);
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .blog-card {
    background-color: var(--card-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
    overflow: hidden;
    transition:
      box-shadow var(--t-base),
      transform var(--t-base);
  }

  .blog-card:hover {
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-2px);
  }

  .blog-card-link {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
    padding: var(--sp-6);
    color: inherit;
    text-decoration: none;
  }

  .blog-card-date {
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .blog-card-title {
    font-size: var(--text-xl);
  }

  .blog-card-description {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  /* Push tags to the bottom of equal-height cards */
  .blog-card-link .tag-list {
    margin-top: auto;
    padding-top: var(--sp-2);
  }
</style>
