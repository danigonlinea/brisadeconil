---
/**
 * BaseLayout — root layout for all pages.
 * Handles: locale-aware meta/SEO (lang, canonical, hreflang, og:locale),
 * dark-theme script, global styles, skip link and cookie consent.
 */
import '../styles/global.css';
import { CONTENT } from '../content/index';
import { DEFAULT_LOCALE, homePath, SUPPORTED_LOCALES, type Locale } from '../i18n/locales';
import galleryManifest from '../data/gallery-manifest';

interface Props {
  /** Route locale — drives <html lang>, meta defaults and chrome copy. */
  locale?: Locale;
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  /** Inject the LodgingBusiness structured data (home only). */
  lodgingSchema?: boolean;
  /**
   * Emit the hreflang alternates trio + og:locale:alternate set.
   * Only meaningful on pages that exist in every locale (homepage routes).
   */
  alternates?: boolean;
}

const {
  locale = DEFAULT_LOCALE,
  title = CONTENT[locale].meta.title,
  description = CONTENT[locale].meta.description,
  ogImage = CONTENT[locale].meta.ogImage,
  canonicalUrl,
  lodgingSchema = false,
  alternates = false,
} = Astro.props;

const siteUrl = import.meta.env.SITE ?? 'https://www.brisadeconil.com';
const base = import.meta.env.BASE_URL ?? '/';
const canonical = canonicalUrl ?? `${siteUrl}${homePath(locale)}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const cookiesPage = `${base.replace(/\/$/, '')}/politica-cookies`;

// Per-locale SEO identifiers from each content module's meta block.
const alternateHrefs = SUPPORTED_LOCALES.map((l) => ({
  lang: l === DEFAULT_LOCALE ? 'x-default' : l,
  href: `${siteUrl}${homePath(l)}`,
}));
const ogLocaleAlternates = SUPPORTED_LOCALES
  .filter((l) => l !== locale)
  .map((l) => CONTENT[l].meta.locale);

// Structured data — LodgingBusiness (home only). Enriched for answer engines.
const galleryPhotos = Object.keys(galleryManifest).map(
  (id) => `${siteUrl}${base}gallery/optimized/${id}-1600.jpg`,
);
// Match the cancellation FAQ in any language: "cancelación", "cancellation",
// "Stornierung"…
const cancellationPolicy =
  CONTENT[locale].faq.items.find((item) => /cancel|storn|annull/i.test(item.q))?.a ??
  CONTENT[locale].faq.items.find((item) => /cancel|storn|annull/i.test(item.a))?.a ??
  '';
const amenityFeatures = CONTENT[locale].amenities.items.map((item) => ({
  '@type': 'LocationFeatureSpecification',
  name: item.label,
  value: true,
}));

const lodgingSchemaData = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'Brisa de Conil',
  description,
  url: canonical,
  image: galleryPhotos,
  photo: galleryPhotos,
  email: 'brisadeconil@gmail.com',
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Calle Rosa de los Vientos',
    addressLocality: 'Conil de la Frontera',
    addressRegion: 'Cádiz',
    postalCode: '11140',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    // Approximate — Mercado de Abastos (frente al apartamento).
    latitude: 36.2778,
    longitude: -6.0897,
  },
  numberOfRooms: 1,
  occupancy: { '@type': 'QuantitativeValue', maxValue: 3 },
  checkinTime: '16:00',
  checkoutTime: '11:30',
  petsAllowed: false,
  smokingAllowed: false,
  amenityFeature: amenityFeatures,
  // Omit rather than ship an empty policy if the FAQ lookup ever fails.
  ...(cancellationPolicy ? { cancellationPolicy } : {}),
};

// Content-Security-Policy — ships as <meta http-equiv> because GitHub Pages
// cannot set HTTP headers. Kept as a single source of truth here so the
// policy is auditable next to the scripts it governs.
//
// Trade-off: script-src/style-src use 'unsafe-inline'. The page relies on
// build-generated inline scripts (theme boot, fonts loader, GA consent
// loader, scroll reveal, React island hydration) plus Astro-inlined
// component styles; their contents change
// on every build, so hash-based allowlisting would break each deploy.
// 'unsafe-inline' still blocks every cross-origin script except
// googletagmanager.com, all plugin/object vectors, non-Google frames,
// cross-origin form posts and unlisted fetch/beacon channels.
// GA's ad-side-channel endpoints (stats.g.doubleclick.net, www.google.es/ads/
// ga-audiences) are deliberately NOT allowlisted: they serve no purpose without
// Google Ads and blocking them shrinks the tracking surface (they log harmless
// console errors for consented users).
// frame-ancestors / sandbox / report-uri are intentionally absent: they are
// ignored inside meta policies.
const cspPolicy = [
  "default-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "frame-src https://www.google.com",
  "img-src 'self' data: https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com",
  "connect-src 'self' https://api.web3forms.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com",
  "font-src https://fonts.gstatic.com",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "script-src 'self' 'unsafe-inline' https://www.googletagmanager.com",
].join('; ');
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />

    <!--
      CSP via meta, not HTTP header: GitHub Pages cannot emit custom headers.
      Must stay before any stylesheet/script/link that loads resources.
    -->
    <meta http-equiv="Content-Security-Policy" content={cspPolicy} />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- hreflang alternates (homepage routes) -->
    {alternates && alternateHrefs.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageUrl} />
    <meta property="og:locale"      content={CONTENT[locale].meta.locale} />
    {alternates && ogLocaleAlternates.map((l) => (
      <meta property="og:locale:alternate" content={l} />
    ))}
    <meta property="og:site_name"   content="Brisa de Conil" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageUrl} />

    {/* Schema.org — LodgingBusiness (home only). Enriched for answer engines. */}
    {lodgingSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(lodgingSchemaData)} />
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="alternate icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Inline dark theme script — must run before first paint to avoid flash -->
    <script is:inline>
      (function () {
        const STORAGE_KEY = 'brisa-theme';
        const saved = localStorage.getItem(STORAGE_KEY);
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved ?? (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <!-- Skip navigation for keyboard users -->
    <a class="skip-link" href="#main-content">{CONTENT[locale].common.skipToContent}</a>

    <!-- Cookie consent banner (non-intrusive bottom card) -->
    <aside
      id="cookie-banner"
      class="cookie-banner"
      role="region"
      aria-label={CONTENT[locale].cookies.ariaLabel}
      hidden
    >
      <div class="cookie-banner-inner">
        <p class="cookie-banner-text">
          {CONTENT[locale].cookies.text}
        </p>
        <div class="cookie-banner-actions">
          <a class="cookie-banner-link" href={cookiesPage}>{CONTENT[locale].cookies.policy}</a>
          <button type="button" class="cookie-banner-btn cookie-banner-btn--ghost" data-cookie-reject>{CONTENT[locale].cookies.reject}</button>
          <button type="button" class="cookie-banner-btn cookie-banner-btn--primary" data-cookie-accept>{CONTENT[locale].cookies.accept}</button>
        </div>
      </div>
    </aside>

    <style>
      .cookie-banner {
        position: fixed;
        left: 50%;
        bottom: var(--sp-3, 0.75rem);
        transform: translateX(-50%);
        width: min(94vw, 600px);
        z-index: 1000;
        background-color: var(--bg-surface, #ffffff);
        color: var(--text-base, #0f172a);
        border: 1px solid var(--border-default, #e2e8f0);
        border-radius: var(--radius-lg, 12px);
        box-shadow: 0 12px 32px rgba(2, 6, 23, 0.18);
      }
      .cookie-banner[hidden] { display: none !important; }
      .cookie-banner-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        column-gap: var(--sp-3, 0.75rem);
        row-gap: var(--sp-2, 0.5rem);
        padding: var(--sp-2, 0.5rem) var(--sp-4, 1rem);
      }
      .cookie-banner-text {
        margin: 0;
        flex: 1 1 15rem;
        font-size: var(--text-xs, 0.75rem);
        line-height: var(--leading-normal, 1.5);
      }
      .cookie-banner-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--sp-2, 0.5rem);
      }
      .cookie-banner-link {
        font-size: var(--text-xs, 0.75rem);
        color: var(--accent-strong, #0d9488);
        text-decoration: underline;
        text-underline-offset: 2px;
        white-space: nowrap;
      }
      .cookie-banner-btn {
        font-family: inherit;
        font-size: var(--text-xs, 0.75rem);
        font-weight: 600;
        padding: calc(var(--sp-1, 0.25rem) + 1px) var(--sp-3, 0.75rem);
        border-radius: var(--radius-md, 8px);
        cursor: pointer;
        border: 1px solid transparent;
        white-space: nowrap;
      }
      .cookie-banner-btn--ghost {
        background: transparent;
        color: var(--text-secondary, #475569);
        border-color: var(--border-default, #e2e8f0);
      }
      .cookie-banner-btn--primary {
        background-color: var(--accent-strong, #0d9488);
        color: #ffffff;
      }
      @media (max-width: 480px) {
        .cookie-banner { width: calc(100vw - var(--sp-3, 0.75rem) * 2); }
        .cookie-banner-btn--ghost, .cookie-banner-btn--primary { flex: 1 1 auto; }
      }
    </style>

    <slot />

    <!-- Fonts: loaded via JS so they never block first paint; display=swap
         renders the hero headline with a fallback font instantly. -->
    <script is:inline>
      (function () {
        const url =
          'https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Source+Sans+3:wght@300;400;500;600&display=swap';
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = url;
        link.media = 'print';
        link.onload = function () {
          link.media = 'all';
        };
        document.head.appendChild(link);
      })();
    </script>
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Source+Sans+3:wght@300;400;500;600&display=swap" />
    </noscript>

    <!-- Cookie consent + Google Analytics (loaded only after explicit consent).
         Runs at the end of body so it never blocks the initial render. -->
    <script is:inline>
      (function () {
        const GA_ID = 'G-27RGED8JEV';
        const CONSENT_KEY = 'brisa-consent';

        function readConsent() {
          try { return localStorage.getItem(CONSENT_KEY); } catch { return null; }
        }
        function writeConsent(value) {
          // Silencioso a propósito: si localStorage no está disponible (p. ej. cookies bloqueadas),
          // el banner simplemente volverá a mostrarse en la siguiente visita.
          try { localStorage.setItem(CONSENT_KEY, value); } catch { /* noop */ }
        }

        function loadGtag() {
          if (window.__brisaConsentLoaded) return;
          const s1 = document.createElement('script');
          s1.async = true;
          s1.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s1);

          const s2 = document.createElement('script');
          s2.textContent =
            "window.dataLayer = window.dataLayer || [];" +
            "function gtag(){dataLayer.push(arguments);}" +
            "gtag('js', new Date());" +
            "gtag('config', '" + GA_ID + "', { anonymize_ip: true });";
          document.head.appendChild(s2);
          window.__brisaConsentLoaded = true;
        }

        function onReady(fn) {
          if (document.readyState !== 'loading') { fn(); }
          else { document.addEventListener('DOMContentLoaded', fn); }
        }

        // Already decided on a previous visit?
        const decision = readConsent();
        if (decision === 'accepted') { loadGtag(); return; }
        if (decision === 'rejected') { return; }

        // No decision yet → show the banner and let the user choose.
        // Scrolling down also counts as acceptance ("scroll = consent").
        onReady(function () {
          const banner = document.getElementById('cookie-banner');
          if (!banner) return;
          banner.hidden = false;

          let decided = false;
          function decide(value, viaScroll) {
            if (decided) return;
            decided = true;
            writeConsent(value);
            if (value === 'accepted') {
              loadGtag();
              try {
                if (window.gtag) {
                  window.gtag('event', 'cookie_consent', {
                    decision: viaScroll ? 'accepted_scroll' : 'accepted',
                  });
                }
              } catch { /* noop: gtag no disponible */ }
            }
            banner.hidden = true;
            window.removeEventListener('scroll', onScroll);
          }

          const accept = banner.querySelector('[data-cookie-accept]');
          const reject = banner.querySelector('[data-cookie-reject]');
          if (accept) accept.addEventListener('click', function () { decide('accepted', false); });
          if (reject) reject.addEventListener('click', function () { decide('rejected', false); });

          // Implicit consent: a meaningful downward scroll counts as acceptance.
          const threshold = Math.round(window.innerHeight * 0.4);
          function onScroll() {
            if (window.scrollY > threshold) decide('accepted', true);
          }
          window.addEventListener('scroll', onScroll, { passive: true });
        });
      })();
    </script>

    <!-- Scroll reveal — Intersection Observer -->
    <script is:inline>
      (function () {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

        // Re-observe after any dynamic content
        document.addEventListener('astro:page-load', () => {
          document.querySelectorAll('.reveal:not(.visible)').forEach((el) => io.observe(el));
        });
      })();
    </script>
  </body>
</html>
