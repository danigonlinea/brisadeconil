---
/**
 * BaseLayout — root layout for all pages.
 * Handles: meta/SEO, dark-theme script, global styles, skip link, i18n script.
 */
import '../styles/global.css';
import * as content from '../content/index';
import { buildI18nScript } from '../i18n/i18n-script';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = content.meta.title,
  description = content.meta.description,
  ogImage = content.meta.ogImage,
  canonicalUrl,
} = Astro.props;

const siteUrl = import.meta.env.SITE ?? 'https://www.brisadeconil.com';
const base = import.meta.env.BASE_URL ?? '/';
const canonical = canonicalUrl ?? siteUrl;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const cookiesPage = `${base.replace(/\/$/, '')}/politica-cookies`;
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageUrl} />
    <meta property="og:locale"      content={content.meta.locale} />
    <meta property="og:site_name"   content="Brisa de Conil" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageUrl} />

    <!-- Schema.org — VacationRental -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LodgingBusiness",
      "name": "Brisa de Conil",
      "description": description,
      "url": canonical,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Calle Rosa de los Vientos",
        "addressLocality": "Conil de la Frontera",
        "addressRegion": "Cádiz",
        "addressCountry": "ES"
      },
      "numberOfRooms": 1,
      "occupancy": {
        "@type": "QuantitativeValue",
        "maxValue": 3
      },
      "amenityFeature": [
        { "@type": "LocationFeatureSpecification", "name": "Aire acondicionado", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "WiFi", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Lavadora", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Lavavajillas", "value": true }
      ]
    })} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="alternate icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />

    <!-- Cookie consent + Google Analytics (loaded only after explicit consent)
         Non-intrusive: GA is NOT loaded until the visitor clicks "Accept".
         Decision persisted in localStorage so the banner doesn't reappear. -->
    <script is:inline>
      (function () {
        var GA_ID = 'G-27RGED8JEV';
        var CONSENT_KEY = 'brisa-consent';

        function readConsent() {
          try { return localStorage.getItem(CONSENT_KEY); } catch (e) { return null; }
        }
        function writeConsent(value) {
          try { localStorage.setItem(CONSENT_KEY, value); } catch (e) {}
        }

        function loadGtag() {
          if (window.__brisaConsentLoaded) return;
          var s1 = document.createElement('script');
          s1.async = true;
          s1.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s1);

          var s2 = document.createElement('script');
          s2.textContent =
            "window.dataLayer = window.dataLayer || [];" +
            "function gtag(){dataLayer.push(arguments);}" +
            "gtag('js', new Date());" +
            "gtag('config', '" + GA_ID + "', { anonymize_ip: true });";
          document.head.appendChild(s2);
          window.__brisaConsentLoaded = true;
        }

        function onReady(fn) {
          if (document.readyState !== 'loading') { fn(); }
          else { document.addEventListener('DOMContentLoaded', fn); }
        }

        // Already decided on a previous visit?
        var decision = readConsent();
        if (decision === 'accepted') { loadGtag(); return; }
        if (decision === 'rejected') { return; }

        // No decision yet → show the banner and let the user choose.
        // Scrolling down also counts as acceptance ("scroll = consent").
        onReady(function () {
          var banner = document.getElementById('cookie-banner');
          if (!banner) return;
          banner.hidden = false;

          var decided = false;
          function decide(value, viaScroll) {
            if (decided) return;
            decided = true;
            writeConsent(value);
            if (value === 'accepted') {
              loadGtag();
              try {
                window.gtag && window.gtag('event', 'cookie_consent', {
                  decision: viaScroll ? 'accepted_scroll' : 'accepted',
                });
              } catch (e) {}
            }
            banner.hidden = true;
            window.removeEventListener('scroll', onScroll);
          }

          var accept = banner.querySelector('[data-cookie-accept]');
          var reject = banner.querySelector('[data-cookie-reject]');
          if (accept) accept.addEventListener('click', function () { decide('accepted', false); });
          if (reject) reject.addEventListener('click', function () { decide('rejected', false); });

          // Implicit consent: a meaningful downward scroll counts as acceptance.
          var threshold = Math.round(window.innerHeight * 0.4);
          function onScroll() {
            if (window.scrollY > threshold) decide('accepted', true);
          }
          window.addEventListener('scroll', onScroll, { passive: true });
        });
      })();
    </script>

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Inline dark theme script — must run before first paint to avoid flash -->
    <script is:inline>
      (function () {
        const STORAGE_KEY = 'brisa-theme';
        const saved = localStorage.getItem(STORAGE_KEY);
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved ?? (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <!-- Inline i18n script — detects locale and translates data-i18n elements before first paint -->
    <script is:inline set:html={buildI18nScript()} />
  </head>
  <body>
    <!-- Skip navigation for keyboard users -->
    <a class="skip-link" href="#main-content" data-i18n="skip-link">Saltar al contenido</a>

    <!--
      DIRECTION CONTRACT — Brisa de Conil Landing Page
      THESIS: Luz y sombra del Atlántico sur. Rechaza crema+coral+terracota (default de categoría).
      OWN-WORLD: Navy-900 en hero, chalk-50 en superficies, teal-500 acento único.
        Lora display, Source Sans 3 cuerpo. Sombras reales con offset.
      STORY: Visitante entiende qué es, dónde está y cómo contactar. La calma persuade.
      FIRST VIEWPORT: Hero full-bleed con overlay navy, titular serif grande, CTA teal.
      FORM: Nueva superficie. Modo Persuade. Seed: manual — brief pinned world.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review,
        the verdict, and DESIGN.md.
    -->

    <!-- Cookie consent banner (non-intrusive bottom card) -->
    <aside
      id="cookie-banner"
      class="cookie-banner"
      role="region"
      aria-label="Aviso de cookies"
      hidden
    >
      <div class="cookie-banner-inner">
        <p class="cookie-banner-text" data-i18n="cookies.text">
          Usamos cookies para mejorar tu experiencia y entender cómo se usa la web. Solo activamos las analíticas si lo aceptas.
        </p>
        <div class="cookie-banner-actions">
          <a class="cookie-banner-link" href={cookiesPage} data-i18n="cookies.policy">Más información</a>
          <button type="button" class="cookie-banner-btn cookie-banner-btn--ghost" data-cookie-reject data-i18n="cookies.reject">Solo lo esencial</button>
          <button type="button" class="cookie-banner-btn cookie-banner-btn--primary" data-cookie-accept data-i18n="cookies.accept">Aceptar</button>
        </div>
      </div>
    </aside>

    <style>
      .cookie-banner {
        position: fixed;
        left: 50%;
        bottom: var(--sp-4, 1rem);
        transform: translateX(-50%);
        width: min(96vw, 720px);
        z-index: 1000;
        background-color: var(--bg-surface, #ffffff);
        color: var(--text-base, #0f172a);
        border: 1px solid var(--border-default, #e2e8f0);
        border-radius: var(--radius-lg, 12px);
        box-shadow: 0 12px 32px rgba(2, 6, 23, 0.2);
      }
      .cookie-banner[hidden] { display: none !important; }
      .cookie-banner-inner {
        display: flex;
        flex-direction: column;
        gap: var(--sp-3, 0.75rem);
        padding: var(--sp-4, 1rem) var(--sp-5, 1.25rem);
      }
      .cookie-banner-text {
        margin: 0;
        font-size: var(--text-sm, 0.875rem);
        line-height: var(--leading-relaxed, 1.6);
      }
      .cookie-banner-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--sp-2, 0.5rem) var(--sp-3, 0.75rem);
      }
      .cookie-banner-link {
        margin-right: auto;
        font-size: var(--text-xs, 0.75rem);
        color: var(--accent, #0d9488);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .cookie-banner-btn {
        font-family: inherit;
        font-size: var(--text-sm, 0.875rem);
        font-weight: 600;
        padding: var(--sp-2, 0.5rem) var(--sp-4, 1rem);
        border-radius: var(--radius-md, 8px);
        cursor: pointer;
        border: 1px solid transparent;
      }
      .cookie-banner-btn--ghost {
        background: transparent;
        color: var(--text-secondary, #475569);
        border-color: var(--border-default, #e2e8f0);
      }
      .cookie-banner-btn--primary {
        background-color: var(--accent, #0d9488);
        color: #ffffff;
      }
      @media (max-width: 480px) {
        .cookie-banner { width: calc(100vw - var(--sp-4, 1rem) * 2); }
        .cookie-banner-actions .cookie-banner-btn { flex: 1 1 auto; }
      }
    </style>

    <slot />

    <!-- Scroll reveal — Intersection Observer -->
    <script is:inline>
      (function () {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

        // Re-observe after any dynamic content
        document.addEventListener('astro:page-load', () => {
          document.querySelectorAll('.reveal:not(.visible)').forEach((el) => io.observe(el));
        });
      })();
    </script>
  </body>
</html>
