---
/**
 * index.astro (root) — Detect the visitor's preferred browser locale and
 * redirect to the matching localized route (/es, /en or /de).
 *
 * Order: an explicit choice (localStorage 'brisa-locale', set by the
 * LanguageSwitcher) wins; otherwise we fall back to navigator.language;
 * finally Spanish (the default locale).
 */
const siteUrl = import.meta.env.SITE ?? 'https://www.brisadeconil.com';
const esUrl = `${siteUrl}/es/`;
const enUrl = `${siteUrl}/en/`;
const deUrl = `${siteUrl}/de/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Brisa de Conil</title>
    <link rel="canonical" href={esUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <script is:inline>
      (function () {
        var LOCALE_KEY = 'brisa-locale';
        var saved = null;
        try { saved = localStorage.getItem(LOCALE_KEY); } catch (e) {}
        var lang = (navigator.language || '').toLowerCase();
        var target;
        if (saved === 'es' || saved === 'en' || saved === 'de') {
          target = saved;
        } else if (lang.indexOf('de') === 0) {
          target = 'de';
        } else if (lang.indexOf('en') === 0) {
          target = 'en';
        } else {
          target = 'es';
        }
        location.replace('/' + target + '/');
      })();
    </script>
  </head>
  <body>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/es/" />
      <p><a href="/es/">Brisa de Conil</a></p>
    </noscript>
  </body>
</html>
