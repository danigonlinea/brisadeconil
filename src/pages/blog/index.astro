---
/**
 * /blog/ — listing of all published posts (Spanish-only for now).
 * Renders a graceful empty state while the collection has no entries.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { CONTENT } from '../../content/index';

const blog = CONTENT.es.blog;
const brand = CONTENT.es.footer.brand;

// Newest first; a stable copy so we never mutate the collection result.
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const siteUrl = import.meta.env.SITE ?? 'https://www.brisadeconil.com';
const base = import.meta.env.BASE_URL ?? '/';
const rootHref = base.replace(/\/$/, '') || '/';
const canonical = `${siteUrl}/blog/`;

const dateFormatter = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={blog.metaTitle} description={blog.description} canonicalUrl={canonical}>
  <header class="blog-topbar">
    <div class="container blog-topbar-inner">
      <a href={rootHref} class="blog-brand">{brand}</a>
      <a href={rootHref} class="blog-backlink">← {blog.backToHome}</a>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <section class="blog-listing">
      <div class="container">
        <span class="section-accent-line" aria-hidden="true"></span>
        <h1 class="section-title">{blog.heading}</h1>
        <p class="section-lead">{blog.lead}</p>

        {posts.length === 0 ? (
          <div class="blog-empty">
            <h2>{blog.emptyTitle}</h2>
            <p>{blog.emptyBody}</p>
          </div>
        ) : (
          <ul class="blog-grid" role="list">
            {posts.map((post) => (
              <li class="blog-card">
                <a href={`${base.replace(/\/$/, '')}/blog/${post.id}/`} class="blog-card-link">
                  <time class="blog-card-date" datetime={post.data.pubDate.toISOString()}>
                    {dateFormatter.format(post.data.pubDate)}
                  </time>
                  <h2 class="blog-card-title">{post.data.title}</h2>
                  <p class="blog-card-description">{post.data.description}</p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <ul class="tag-list" role="list">
                      {post.data.tags.map((tag) => <li class="tag-chip">{tag}</li>)}
                    </ul>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </main>

  <Footer footer={CONTENT.es.footer} cta={CONTENT.es.nav.cta} blogLabel={blog.navLabel} />
</BaseLayout>

<style>
  .blog-listing {
    padding-block: var(--sp-12) var(--sp-20);
  }

  @media (min-width: 768px) {
    .blog-listing {
      padding-block: var(--sp-16) var(--sp-24);
    }
  }

  /* ── Top bar ─────────────────────────────────────────────────────────────── */
  .blog-topbar {
    background-color: var(--bg-dark);
  }

  .blog-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    height: 64px;
  }

  .blog-brand {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-on-dark);
    text-decoration: none;
    transition: color var(--t-fast);
  }

  .blog-brand:hover {
    color: var(--color-teal-400);
    text-decoration: none;
  }

  .blog-backlink {
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    text-decoration: none;
    transition: color var(--t-fast);
  }

  .blog-backlink:hover {
    color: var(--text-on-dark);
    text-decoration: underline;
  }

  /* ── Empty state ─────────────────────────────────────────────────────────── */
  .blog-empty {
    max-width: 36rem;
    margin-inline: auto;
    margin-top: var(--sp-12);
    padding: var(--sp-12) var(--sp-8);
    text-align: center;
    background-color: var(--card-bg);
    border: 2px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .blog-empty h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--sp-3);
  }

  .blog-empty p {
    margin-inline: auto;
    color: var(--text-secondary);
  }

  /* ── Cards grid ──────────────────────────────────────────────────────────── */
  .blog-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-6);
    margin-top: var(--sp-10);
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .blog-card {
    background-color: var(--card-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
    overflow: hidden;
    transition:
      box-shadow var(--t-base),
      transform var(--t-base);
  }

  .blog-card:hover {
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-2px);
  }

  .blog-card-link {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
    padding: var(--sp-6);
    color: inherit;
    text-decoration: none;
  }

  .blog-card-date {
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .blog-card-title {
    font-size: var(--text-xl);
  }

  .blog-card-description {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  /* Push tags to the bottom of equal-height cards */
  .blog-card-link .tag-list {
    margin-top: auto;
    padding-top: var(--sp-2);
  }
</style>
