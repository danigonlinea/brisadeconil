---
/**
 * wifi-poster.astro — Standalone printable poster (14×23 cm vertical).
 * NOT wrapped in BaseLayout: minimal HTML/CSS, optimized for print.
 */
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WiFi — Brisa de Conil</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Source+Sans+3:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      /* ── Design System tokens (from global.css) ── */
      :root {
        --color-navy-900: #0c1f2e;
        --color-navy-700: #1a3d54;
        --color-navy-600: #235070;
        --color-chalk-50: #f7f5f0;
        --color-chalk-100: #ede9e0;
        --color-chalk-200: #d8d1c4;
        --color-teal-500: #2aa598;
        --color-teal-600: #1d8a7e;
        --bg-surface: #ffffff;
        --screen-preview-bg: #e5e5e5;
        --font-serif: "Lora", Georgia, "Times New Roman", serif;
        --font-sans: "Source Sans 3", system-ui, -apple-system, sans-serif;
      }

      /* ── Reset ── */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-size: 16px;
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        font-family: var(--font-sans);
        font-weight: 400;
        line-height: 1.5;
        color: var(--color-navy-900);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* ── Screen preview ── */
      @media screen {
        body {
          background-color: var(--screen-preview-bg);
          padding: 2rem 0;
        }
      }

      /* ── Poster container ── */
      .poster {
        width: 14cm;
        height: 23cm;
        margin: 0 auto;
        padding: 0.5cm;
        background-color: var(--color-chalk-50);
        position: relative;
        overflow: hidden;
      }

      @media screen {
        .poster {
          box-shadow: 0 4px 24px rgba(12, 31, 46, 0.18);
        }
      }

      /* ── Header ── */
      .poster-header {
        display: flex;
        align-items: center;
        gap: 0.5cm 0;
        flex-wrap: wrap;
        margin-bottom: 0.6cm;
      }

      .poster-header::after {
        content: "";
        display: block;
        width: 1.3cm;
        height: 2px;
        background-color: var(--color-teal-500);
        margin-top: 0.4cm;
      }

      .poster-logo {
        height: 2.5cm;
        width: auto;
        display: block;
      }

      .poster-brand {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: 22pt;
        color: var(--color-navy-900);
        line-height: 1.15;
        letter-spacing: -0.03em;
      }

      .poster-subtitle {
        font-family: var(--font-sans);
        font-weight: 400;
        font-size: 11pt;
        color: var(--color-navy-700);
        margin-top: 2px;
      }

      /* ── WiFi section ── */
      .poster-wifi {
        background-color: var(--bg-surface);
        border-radius: 8px;
        padding: 0.5cm;
        margin-bottom: 0.5cm;
      }

      .poster-wifi-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3cm;
        text-align: center;
      }

      .poster-qr {
        width: 4cm;
        height: 4cm;
        border: 1px solid var(--color-chalk-200);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background-color: #ffffff;
      }

      .poster-password-label {
        font-family: var(--font-sans);
        font-weight: 400;
        font-size: 9pt;
        color: var(--color-navy-700);
        margin-bottom: 2px;
      }

      .poster-password {
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 11pt;
        letter-spacing: 0.05em;
        color: var(--color-navy-900);
        margin-bottom: 0.3cm;
      }

      .poster-wifi-hint {
        font-family: var(--font-sans);
        font-weight: 400;
        font-size: 8pt;
        color: var(--color-navy-700);
      }

      /* ── Rules section ── */
      .poster-rules {
        background-color: var(--color-chalk-100);
        border-radius: 8px;
        padding: 0.5cm;
        margin-bottom: 0.5cm;
      }

      .poster-rules-title {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: 16pt;
        color: var(--color-navy-900);
        margin-bottom: 0.4cm;
      }

      .poster-rules-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.25cm;
      }

      .poster-rule {
        display: flex;
        align-items: flex-start;
        gap: 0.3cm;
        font-family: var(--font-sans);
        font-weight: 400;
        font-size: 10pt;
        color: var(--color-navy-900);
        line-height: 1.4;
      }

      .poster-rule-icon {
        flex-shrink: 0;
        font-size: 12pt;
        line-height: 1.4;
      }

      /* ── Welcome section ── */
      .poster-welcome {
        text-align: center;
      }

      .poster-welcome::before {
        content: "";
        display: block;
        width: 1.3cm;
        height: 2px;
        background-color: var(--color-teal-500);
        margin: 0 auto 0.3cm;
      }

      .poster-welcome-text {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: 400;
        font-size: 12pt;
        color: var(--color-navy-900);
        line-height: 1.65;
      }

      /* ── Print styles ── */
      @media print {
        @page {
          size: 14cm 23cm;
          margin: 0.3cm; /* bleed */
        }

        body {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
          background: white !important;
          padding: 0 !important;
        }

        .poster {
          margin: 0 !important;
          box-shadow: none !important;
          width: 14cm;
          height: 23cm;
        }

        .poster-rules {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
      }
    </style>
  </head>
  <body>
    <main class="poster">
      <!-- Header -->
      <header class="poster-header">
        <img
          class="poster-logo"
          src="/logos/brisadeconil-logo.png"
          alt="Logo Brisa de Conil"
          width="128"
          height="128"
        />
        <div class="poster-header-text">
          <h1 class="poster-brand">Brisa de Conil</h1>
          <p class="poster-subtitle">Apartamento vacacional</p>
        </div>
      </header>

      <!-- WiFi -->
      <section class="poster-wifi" aria-label="WiFi">
        <div class="poster-wifi-content">
          <div class="poster-qr">
            <img
              src="/qr/codigo-qr-wifi-5g.png"
              alt="Código QR para conectarse al WiFi"
              width="128"
              height="128"
              style="width:100%;height:100%;object-fit:contain;"
            />
          </div>
          <div class="poster-wifi-info">
            <p class="poster-password-label">Contraseña WiFi:</p>
            <p class="poster-password">Daniel3487</p>
            <p class="poster-wifi-hint">Escanea el código para conectarte</p>
          </div>
        </div>
      </section>

      <!-- Rules -->
      <section class="poster-rules" aria-labelledby="rules-title">
        <h2 class="poster-rules-title" id="rules-title">Normas de la casa</h2>
        <ul class="poster-rules-list">
          <li class="poster-rule">
            <span class="poster-rule-icon">🗑️</span>
            <span>Saca la basura antes de irte.</span>
          </li>
          <li class="poster-rule">
            <span class="poster-rule-icon">🕐</span>
            <span>Check-in a partir de las 16:00 y salida entre las 11:30 y las 12:00.</span>
          </li>
          <li class="poster-rule">
            <span class="poster-rule-icon">🐾</span>
            <span>No se admiten mascotas en el apartamento.</span>
          </li>
          <li class="poster-rule">
            <span class="poster-rule-icon">🚭</span>
            <span>No se permite fumar en el apartamento.</span>
          </li>
          <li class="poster-rule">
            <span class="poster-rule-icon">🔇</span>
            <span>Ruidos: respeta el descanso de los vecinos, especialmente en horario nocturno.</span>
          </li>
        </ul>
      </section>

      <!-- Welcome / closing -->
      <section class="poster-welcome" aria-label="Bienvenida">
        <p class="poster-welcome-text">
          Que tengáis una agradable estancia.
        </p>
      </section>
    </main>
  </body>
</html>
