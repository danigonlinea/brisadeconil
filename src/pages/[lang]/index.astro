---
/**
 * /en/ and /de/ — pre-rendered English and German homepages.
 * The default locale (es) lives at / and is intentionally absent here.
 */
import type { Locale } from '../../i18n/locales';
import { ALTERNATE_LOCALES } from '../../i18n/locales';
import HomePage from '../../templates/HomePage.astro';

export function getStaticPaths() {
  return ALTERNATE_LOCALES.map((locale) => ({
    params: { lang: locale satisfies Locale as string },
  }));
}

const { lang } = Astro.params;
// Fail fast at build time if the route ever receives an unregistered locale.
if (lang !== 'en' && lang !== 'de') {
  throw new Error(`[lang] route received an unsupported locale: "${lang}"`);
}
---

<HomePage locale={lang} />
