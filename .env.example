# Environment variables for Brisa de Conil
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real keys.
# Get your Web3Forms key free at https://web3forms.com

# Web3Forms public key — client-side (PRIMARY)
# Key pública y segura (solo enruta emails, sin datos sensibles).
# ContactForm la envía directamente a api.web3forms.com desde el navegador.
# En GitHub Actions, se inyecta como PUBLIC_WEB3FORMS_KEY desde el secret WEB3FORMS_KEY.
PUBLIC_WEB3FORMS_KEY=YOUR_WEB3FORMS_ACCESS_KEY

# Web3Forms access key — server-side (DORMANT)
# Solo la usa el endpoint /api/contact (src/pages/api/contact.ts), que NO se
# ejecuta en GitHub Pages (hosting estático). Se mantiene por si en el futuro
# se migra a un hosting con servidor.
# En GitHub Actions, se inyecta como WEB3FORMS_ACCESS_KEY desde el secret WEB3FORMS_KEY.
WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY
