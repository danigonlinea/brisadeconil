# Environment variables for Brisa de Conil
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real keys.
# Get your Web3Forms key free at https://web3forms.com

# Web3Forms access key — server-side
# La usa el endpoint /api/contact (src/pages/api/contact.ts) para reenviar
# el formulario a Web3Forms sin exponer la key en el cliente.
# En GitHub Actions, añádela como secret llamado WEB3FORMS_KEY.
WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY

# Web3Forms public key — client-side (legacy / fallback)
# Key pública y segura (solo enruta emails, sin datos sensibles).
# ContactForm la usa como fallback directo cuando el endpoint server-side
# no está disponible (p. ej. GitHub Pages, hosting estático).
# En GitHub Actions, usa el mismo secret WEB3FORMS_KEY.
PUBLIC_WEB3FORMS_KEY=YOUR_WEB3FORMS_ACCESS_KEY
