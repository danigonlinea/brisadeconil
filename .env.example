# Environment variables for Brisa de Conil
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real keys.

# Web3Forms access key
# Get yours free at https://web3forms.com (no account needed for basic use)
# This key is PUBLIC-safe (it only routes emails; no sensitive data).
# In GitHub Actions, add it as a secret named WEB3FORMS_KEY
PUBLIC_WEB3FORMS_KEY=YOUR_WEB3FORMS_ACCESS_KEY
